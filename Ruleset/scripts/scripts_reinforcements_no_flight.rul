extended:
  tags:
    RuleArmor:
      UNIT_CANT_ADJUST_ALTITUDE: int #this is the % of TUs the unit spawns with; if unspecified, defaults to 25% of max.

  scripts:
    createUnit:
      - new: ROSIGMA_cU_restrict_flight
        offset: 2
        code: |
          var ptr RuleArmor armorRule;
          var int temp;
          var int no_height_change;

          unit.getRuleArmor armorRule;
          armorRule.getTag no_height_change Tag.UNIT_CANT_ADJUST_ALTITUDE;

          if lt no_height_change 1; #default to 25% of max TUs if this tag is unspecified
            return;
          end;

          unit.MoveCost.setBaseClimbTimePercent 9999;
          # debug_log "createUnit | ROSIGMA_cU_restrict_flight | offset: 2 | No reinforcement TU tag detected. Defaulting to: " no_height_change;

          return;