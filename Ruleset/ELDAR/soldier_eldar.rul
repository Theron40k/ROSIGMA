extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

# NAMING CONVENTION:
#
# FACTION.TIER.NAME
# EXAMPLE: ELDAR.TIER1.GUARDIAN
#
# STRUCTURE of this file
# ELDAR.TIER1 # GUARDIANS
# ELDAR.TIER2 # ASPECT WARRIORS (path of the warrior)
# ELDAR.TIER3 # EXARCH / AUTARCH
# ELDAR.TIER2_PSY # PSY WARRIORS (path of the psyker)
# ELDAR.TIER3_PSY # PSY WARRIORS (Mastery of psychic power)
# ELDAR.TIER4 # special units (example: avatar of khaine)
# ELDAR.TIER3_MIXED # Path of the warlock
# ELDAR.WRAITHGUARD # Wraithguards

soldiers:

# ELDAR.TIER1 # GUARDIANS

  - &ELDAR_GUARDIAN
    type: STR_ELDAR_GUARDIAN_PLAYER
    requires:
      - STR_RECRUIT_ELDAR_T1
    flagOffset: 100
    #requiresBuyBaseFunc: [ELDAROUT] #eldar guardian now will be recruitable in a base
    costBuy: 30000
    costSalary: 15000
    minStats:
      tu: 55
      stamina: 35
      health: 25
      bravery: 40
      reactions: 40
      firing: 55
      throwing: 30
      strength: 20
      psiStrength: 50
      psiSkill: 20
      melee: 30
    maxStats:
      tu: 80
      stamina: 65
      health: 40
      bravery: 80
      reactions: 70
      firing: 75
      throwing: 60
      strength: 35
      psiStrength: 100
      psiSkill: 20
      melee: 60
    statCaps:
      tu: 100
      stamina: 100
      health: 70  # +10
      bravery: 100
      reactions: 80
      firing: 110
      throwing: 75
      strength: 60
      psiStrength: 100
      psiSkill: 100
      melee: 100
    trainingStatCaps:
      tu: 80
      stamina: 80
      health: 60
      firing: 70
      throwing: 65
      strength: 40
      psiStrength: 100
      psiSkill: 100
      melee: 70
    dogfightExperience:
      bravery: 10
      reactions: 30
      firing: 25
    allowPiloting: true
    allowPromotion: true
    standHeight: 22
    kneelHeight: 14
    avatarOffsetX: 66
    avatarOffsetY: 30
    femaleFrequency: 50
    armor: STR_ELDAR_ARMOR_GUARDIAN_PLAYER
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
      - STR_ELDAR_GUARDIAN_RANK_0
      - STR_ELDAR_GUARDIAN_RANK_1
      - STR_ELDAR_GUARDIAN_RANK_2
      - STR_ELDAR_GUARDIAN_RANK_3
      - STR_ELDAR_GUARDIAN_RANK_4
      - STR_ELDAR_GUARDIAN_RANK_5
    rankSprite: 4012
    rankBattleSprite: 4012
    rankTinySprite: 4012
    soldierNames:
      - delete
      - Names/eldar_guardian.nam

  - type: STR_ELDAR_RANGER_PLAYER # Eldar Ranger
    requires:
      - STR_RECRUIT_ELDAR_T1
    flagOffset: 100
    dogfightExperience:
      bravery: 10
      reactions: 30
      firing: 25
    allowPiloting: true
    allowPromotion: true
    standHeight: 22
    kneelHeight: 14
    avatarOffsetX: 66
    avatarOffsetY: 30
    femaleFrequency: 50
    armor: STR_ELDAR_RANGER_ARMOR_P
    costBuy: 0 #eldar ranger are requested via recipe
    costSalary: 15000
    minStats:
      tu: 55
      stamina: 40
      health: 25
      bravery: 50
      reactions: 40
      firing: 65
      throwing: 30
      strength: 20
      psiStrength: 15
      psiSkill: 20
      melee: 30
    maxStats:
      tu: 70
      stamina: 65
      health: 30
      bravery: 80
      reactions: 70
      firing: 80
      throwing: 40
      strength: 25
      psiStrength: 100
      psiSkill: 20
      melee: 50
    statCaps:
      tu: 100
      stamina: 100
      health: 70
      bravery: 100
      reactions: 80
      firing: 110
      throwing: 75
      strength: 60
      psiStrength: 100
      psiSkill: 100
      melee: 100
    rankSprite: 4018
    rankBattleSprite: 4018
    rankTinySprite: 4018
    rankStrings:
      - STR_ELDAR_RANGER_RANK_0
      - STR_ELDAR_RANGER_RANK_1
      - STR_ELDAR_RANGER_RANK_2
      - STR_ELDAR_RANGER_RANK_3
      - STR_ELDAR_RANGER_RANK_4
      - STR_ELDAR_RANGER_RANK_5
    soldierNames:
      - delete
      - Names/eldar_ranger.nam

# DEPRECATED. in future version (3.4 onward) please add - delete: name to keep rosigma clean

#Male eldar guardian
  #- &ELDAR_GUARDIAN
  - type: STR_ELDAR_M
    refNode: *ELDAR_GUARDIAN
    armor: STR_ELDAR_ARMOR_M
    femaleFrequency: 0
    soldierNames:
      - delete
      - Names/eldar_guardian_male.nam

# Female eldar guardian
  - type: STR_ELDAR_F
    refNode: *ELDAR_GUARDIAN
    armor: STR_ELDAR_ARMOR_F
    femaleFrequency: 100
    soldierNames:
      - delete
      - Names/eldar_guardian_female.nam

