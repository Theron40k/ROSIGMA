extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

# NAMING CONVENTION:
#
# FACTION.TIER.NAME
# EXAMPLE: ELDAR.TIER1.GUARDIAN
#
# STRUCTURE of this file
# ELDAR.TIER1 # GUARDIANS
# ELDAR.TIER2 # ASPECT WARRIORS (path of the warrior)
# ELDAR.TIER3 # EXARCH / AUTARCH
# ELDAR.TIER2_PSY # PSY WARRIORS (path of the psyker)
# ELDAR.TIER3_PSY # PSY WARRIORS (Mastery of psychic power)
# ELDAR.TIER4 # special units (example: avatar of khaine)
# ELDAR.WRAITHGUARD # Wraithguards

soldiers:

# ELDAR.TIER1 # GUARDIANS

  - &ELDAR_GUARDIAN
    type: STR_ELDAR_GUARDIAN_PLAYER
    requires:
      - STR_ELDAR_PATH
    flagOffset: 100
    requiresBuyBaseFunc: [ELDAROUT]
    costBuy: 30000
    costSalary: 15000
    minStats:
      tu: 60
      stamina: 30
      health: 25
      bravery: 50
      reactions: 40
      firing: 55  # +5
      throwing: 30
      strength: 20
      psiStrength: 50
      psiSkill: 20
      melee: 40
    maxStats:
      tu: 80
      stamina: 65
      health: 40
      bravery: 80
      reactions: 70
      firing: 75
      throwing: 60
      strength: 30  # +5
      psiStrength: 100
      psiSkill: 10
      melee: 50
    statCaps:
      tu: 100
      stamina: 100
      health: 70  # +10
      bravery: 100
      reactions: 80
      firing: 110
      throwing: 70
      strength: 60
      psiStrength: 100
      psiSkill: 100
      melee: 100
    trainingStatCaps:
      tu: 80
      stamina: 80
      health: 60
      firing: 70
      throwing: 65
      strength: 30
      psiStrength: 100
      psiSkill: 100
      melee: 80
    dogfightExperience:
      bravery: 10
      reactions: 30
      firing: 25
    allowPiloting: true
    allowPromotion: true
    standHeight: 22
    kneelHeight: 14
    avatarOffsetX: 66
    avatarOffsetY: 42
    femaleFrequency: 50
    armor: STR_ELDAR_ARMOR_GUARDIAN_PLAYER
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
      - STR_ELDAR_RANK_0
      - STR_ELDAR_RANK_1
      - STR_ELDAR_RANK_2
      - STR_ELDAR_RANK_3
      - STR_ELDAR_RANK_4
      - STR_ELDAR_RANK_5
    rankSprite: {mod: 40k, index: 883}
    rankBattleSprite: {mod: 40k, index: 266}
    rankTinySprite: {mod: 40k, index: 181}
    soldierNames:
      - delete
      - Names/eldar_guardian.nam

# DEPRECATED. in future version (3.4 onward) please add - delete: name to keep rosigma clean

#Male eldar guardian
  #- &ELDAR_GUARDIAN
  - type: STR_ELDAR_M
    refnode: *ELDAR_GUARDIAN
    armor: STR_ELDAR_ARMOR_M
    femaleFrequency: 0
    soldierNames:
      - delete
      - Names/eldar_guardian_male.nam

# Female eldar guardian
  - type: STR_ELDAR_F
    refNode: *ELDAR_GUARDIAN
    armor: STR_ELDAR_ARMOR_F
    femaleFrequency: 100
    soldierNames:
      - delete
      - Names/eldar_guardian_female.nam

