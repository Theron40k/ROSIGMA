events:
  - name: STR_ELDAR_ASURYANI_CAMPAING_START
    description: STR_ELDAR_ASURYANI_CAMPAING_START_SHORT_DESCRIPTION
    background: ELDAR_GUARDIAN_ASSAULTING.SCR
    adhocMissionScriptTags: ["adhocStarterBaseSlaan_eldar", "adhocStarterBaseGangers_eldar_Tag"]
    # adhocMissionScriptTags: ["intro_missions", "tenaxBaseL1", "PRINCEBISHOPBaseL1", "redeemedBaseL1"]
    spawnedPersons: 20
    spawnedPersonType: STR_ELDAR_GUARDIAN_PLAYER
    spawnedCraftType: STR_WAVESERPENT
    everyMultiItemList: # todo: review list of equipment
      STR_ELDAR_CITIZEN: 250
      STR_AELDARI_FLAMER: 2
      STR_AELDARI_FLAMER_FUEL: 6
      #STR_SHOTGUN: 5
      #STR_SHOTGUN_SHELLS: 10
      #STR_STUN_SHELLS: 10
      #STR_STUB_RIFLE: 5
      #STR_STUB_GUN_AMMO: 15
      #STR_LASER_RIFLEG: 5
      #STR_LASGUN_CLIP: 10
      STR_CATAPULT: 15
      STR_CATAPULT_PISTOL: 3
      STR_SHURIKEN_CLIP: 36
      #STR_CHAINSWORD: 5
      STR_AELDARI_SWORD: 10
      STR_AELDARI_CHAINSWORD: 1
      STR_AELDARI_POWERSWORD: 1
      STR_STUN_ROD: 5
      STR_GRENADE: 10
      #STR_KRAK_GRENADE: 10
      STR_ELDAR_GRENADE: 4
      STR_TRAUMA_PACK: 5
      STR_CRATED_HORNET: 1
    researchList: [STR_ELDAR_ASURYANI_CAMPAING_LETTER_RECEIVED]

  - name: STR_ELDAR_MIDTIER_REINFORCEMENTS
    description: STR_ELDAR_MIDTIER_REINFORCEMENTS_DESCRIPTION #Temporary
    background: ELDAR_GUARDIAN_ASSAULTING.SCR # Temporary
    spawnedPersons: 1
    spawnedPersonType: STR_ENGINEER
