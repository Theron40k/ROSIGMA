      0:
        STR_NORTH_AMERICA: 18
        STR_ARCTIC: 4
        STR_ANTARCTICA: 4
        STR_SOUTH_AMERICA: 10
        STR_EUROPE: 16
        STR_NORTH_AFRICA: 12
        STR_SOUTHERN_AFRICA: 8
