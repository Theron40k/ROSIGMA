extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

skills:
  # STEALTH SKILLS
  - type: STR_SKILL_WARPSPIDER_STEALTH_TELEPORT  # Allows unit to enter stealth mode again at the cost of their turn
    tags:
      SKILL_LIKE_FIGHTING_A_SHADOW_ID: 2
      SKILL_LIKE_FIGHTING_A_SHADOW_RESTEALTH_DURATION: 3
      SKILL_IS_PSYCHIC_POWER: 80
    costUse:
      time: 70 # allows to walk a bit during the same turn
      energy: 30 # taxing to use
      stun: 20 # entering the warp for eldar is risking its soul stolen from slaanesh
    flatUse:
      time: false
      energy: true
      stun: true

  - type: STR_SKILL_BANSHEE_DASH
    tags:
      #SKILL_LIKE_FIGHTING_A_SHADOW_ID: 2
      #SKILL_LIKE_FIGHTING_A_SHADOW_RESTEALTH_DURATION: 4
      #SKILL_IS_PSYCHIC_POWER: 40
      SKILL_SPRINT_MOVECOST_TIMEPERCENT: 70 # what is the new TU % when sprinting
      SKILL_SPRINT_MOVECOST_ENERGYPERCENT: 70 # what is the new ENERGY % when sprinting
      SKILL_SPRINT_COOLDOWN_PERIOD: 11 # remember: each "turn" is 1 player, 1 enemy, 1 neutral, 11 turn is either at the start of player turn 4 or at the start of neutral turn 4
      SKILL_SPRINT_REUSABLE: 0 #is sprint reusable? 1=YES 0=Limited uses (use SKILL_SPRINT_USES to specify how many)
      SKILL_SPRINT_USES: 2
    costUse:
      time: 20 #
      energy: 20 # taxing to use
      stun: 10 # using the warp for eldar is risking its soul stolen from slaanesh
    flatUse:
      time: true
      energy: true
      stun: true

  - type: STR_SKILL_BANSHEE_EXARCH_DASH
    tags:
      #SKILL_IS_PSYCHIC_POWER: 40
      SKILL_SPRINT_MOVECOST_TIMEPERCENT: 49 # what is the new TU % when sprinting
      SKILL_SPRINT_MOVECOST_ENERGYPERCENT: 49 # what is the new ENERGY % when sprinting
      SKILL_SPRINT_COOLDOWN_PERIOD: 8 # remember: each "turn" is 1 player, 1 enemy, 1 neutral, 8 turn is either at the start of player turn 3 or at the start of neutral turn 3
      SKILL_SPRINT_REUSABLE: 0 #is sprint reusable? 1=YES
      SKILL_SPRINT_USES: 3
    costUse:
      time: 20 #
      energy: 20 #
      stun: 10 # using the warp for eldar is risking its soul stolen from slaanesh
    flatUse:
      time: true
      energy: true
      stun: true

  # Intimidation
  # - type: STR_SKILL_BANSHEE_MASK_INTIMIDATION
  #   costUse:
  #     time: 25 # quick use, but I don't think it can work for reactions as a skill.
  #   targetMode: 8
  #   compatibleWeapons: [STR_BANSHEE_INTIMIDATION_SCREAM_TOKEN]
  #   checkHandsOnly: false
  #   battleType: 1

  # - type: STR_SKILL_BANSHEE_MASK_DAMAGE
  #   costUse:
  #     time: 35 # quick use, but I don't think it can work for reactions as a skill.
  #   targetMode: 8
  #   compatibleWeapons: [STR_BANSHEE_WARP_SCREAM_TOKEN]
  #   checkHandsOnly: false
  #   battleType: 1

soldiers:
  - type: STR_ELDAR_SPIDER_PLAYER
    skillIconSprite: 221  #
    skills:
      - STR_SKILL_WARPSPIDER_STEALTH_TELEPORT

  - type: STR_ELDAR_SPIDEREX_PLAYER
    skillIconSprite: 221
    skills:
      - STR_SKILL_WARPSPIDER_STEALTH_TELEPORT

  - type: STR_ELDAR_BANSHEE_F
    skillIconSprite: 250 # TODO: change to generic banshee
    skills:
      - STR_SKILL_BANSHEE_DASH

  - type: STR_ELDAR_BANSHEE_EXARCH_PLAYER
    skillIconSprite: 250 # TODO: change to generic banshee
    skills:
      - STR_SKILL_BANSHEE_DASH
