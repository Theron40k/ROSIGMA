extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

armors:
  - &WRAITHGUARD_ARMOR
    type: STR_WRAITHGUARD_ARMOR_P
    antiCamouflageAtDay: 5
    antiCamouflageAtDark: 5
    visibilityAtDay: 40
    visibilityAtDark: 30
    allowInv: true
    frontArmor: 120
    sideArmor: 100
    rearArmor: 100
    underArmor: 120
    size: 2
    units:
      - STR_ELDAR_FALLEN
    damageModifier:  # CENT ARMOR
      - 1.0  # none
      - 0.8  # AP
      - 0.4  # FLAMES
      - 0.9  # HE
      - 0.9  # LASCANON
      - 0.8  # PLASMA  # -10%
      - 0.9  # STUN
      - 0.9  # MELEE
      - 0.9  # ACID
      - 0.0  # SMOKE
      - 0.2  # IMPACT
      - 0.9  # MELTA
    loftempsSet: [92, 89, 90, 91]
    drawingRoutine: 5
    allowsRunning: false  # Mechanical
    tags:
      INFECTION_RESIST: 100
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_MECHANICAL: 1
  - type: STR_WRAITHGUARD_ARMOR_P_SHIELD
    refNode: *WRAITHGUARD_ARMOR
    storeItem: STR_ELDAR_SHIELD
    frontArmor: 125
    sideArmor: 110
    rearArmor: 100
    underArmor: 120
    units:
      - STR_ELDAR_FALLEN
    tags:
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 10
      ARMOR_ENERGY_SHIELD_DECAY: 10
      INFECTION_RESIST: 100
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_MECHANICAL: 1

  - &GUARDIAN_ARMOR
    type: STR_ELDAR_ARMOR_M               # GUARDIAN
    storeItem: STR_NONE
    visibilityAtDay: 40
    visibilityAtDark: 15
    frontArmor: 30
    sideArmor: 25
    rearArmor: 16
    underArmor: 15
    drawingRoutine: 0
    damageModifier:  # ELDAR ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 0.5  # FLAMES
      - 1.0  # HE
      - 0.7  # LASCANON
      - 0.7  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 0.5  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.0  # MELTA
    loftempsSet: [3]
    units:
      - STR_ELDAR_M
    builtInWeapons:
      - INV_NULL_3X3
    tags:
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 2
