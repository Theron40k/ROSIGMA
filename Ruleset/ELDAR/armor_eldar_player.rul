      M11: ["", "ELDAR", "CLOSEDHELMET8", "ACCESSORY7"]
      F0: ["", "ELDAR_F", "OPENHELMET_F1", "ACCESSORY4"]
      F1: ["", "ELDAR_F", "OPENHELMET_F2", "ACCESSORY10"]
      F2: ["", "ELDAR_F", "CLOSEDHELMET7", "ACCESSORY5"]
      F3: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY11"]
      F4: ["", "ELDAR_F", "CLOSEDHELMET1", "ACCESSORY6"]
      F5: ["", "ELDAR_F", "CLOSEDHELMET2", "ACCESSORY12"]
      F6: ["", "ELDAR_F", "CLOSEDHELMET3", "ACCESSORY7"]
      F7: ["", "ELDAR_F", "CLOSEDHELMET4", "ACCESSORY1"]
      F8: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY8"]
      F9: ["", "ELDAR_F", "CLOSEDHELMET6", "ACCESSORY2"]
      F10: ["", "ELDAR_F", "CLOSEDHELMET7", "ACCESSORY9"]
      F11: ["", "ELDAR_F", "CLOSEDHELMET8", "ACCESSORY3"]
    drawingRoutine: 0
    damageModifier:  # ELDAR ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 0.5  # FLAMES
      - 1.0  # HE
      - 0.7  # LASCANON
      - 0.7  # PLASMA
      - 1.0  # STUN
      - 0.4  # MELEE # very melee resistant
      - 0.5  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.0  # MELTA
    loftempsSet: [3]
    units:
      - STR_ELDAR_SCORPION_M
      - STR_ELDAR_ASPECT_WARRIOR_PLAYER
    builtInWeapons:
      - INV_NULL_3X1_BACKPACK
    stats: #Scorpion armor get better bonus to melee
      tu: 12
      stamina: 10
      health: 5
      bravery: 15 # in the face of danger
      reactions: 0
      firing: -10
      throwing: -10
      strength: 10
      melee: 5
    tags:
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 33
      ARMOR_MAX_SUCCESSFUL_DODGES: 3

  - type: STR_ELDAR_ARMOR5_P_SHIELD       # SCORPION PLAYER
