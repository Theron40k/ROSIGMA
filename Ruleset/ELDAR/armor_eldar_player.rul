      - STR_ELDAR_M
    builtInWeapons:
      - AUX_ELDAR_SHIELD
    tags:
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 10
      ARMOR_ENERGY_SHIELD_DECAY: 10
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

  - type: STR_ELDAR_ARMOR_F               # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    units:
      - STR_ELDAR_F

  - type: STR_ELDAR_ARMOR_FH        # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    customArmorPreviewIndex: 262
    units:
      - STR_ELDAR_F
    builtInWeapons:
      - AUX_ELDAR_KIT
  - type: STR_ELDAR_ARMOR_F_SHIELD        # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    spriteSheet: ELDARDR21S.PCK
    customArmorPreviewIndex: 250
    storeItem: STR_ELDAR_SHIELD
    units:
      - STR_ELDAR_F
    builtInWeapons:
      - AUX_ELDAR_SHIELD
    tags:
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 10
      ARMOR_ENERGY_SHIELD_DECAY: 10
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

#

# ELDAR.TIER2 # ASPECT WARRIORS (path of the warrior)

  - &AVENGER_ARMOR
