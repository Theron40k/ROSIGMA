  # scorpion units will rely on camo and tankiness
  - &SCORPION_ARMOR
    type: STR_ELDAR_ARMOR5_P       # SCORPION PLAYER
    requires: STR_ELDAR_SCORPION_RESEARCH
    storeItem: STR_NONE
    visibilityAtDay: 40
    visibilityAtDark: 30
    camouflageAtDay: 20  # you need to be 20 tiles closer than max vision range to see this unit in the light
    camouflageAtDark: 13  # you need to be 12 tiles closer than max vision range (at night!) to see this unit in the dark
    antiCamouflageAtDay: 5
    antiCamouflageAtDark: 8
    frontArmor: 100 #One of the stronger aspect armors 3+ Save
    sideArmor: 90
    rearArmor: 80
    underArmor: 70
    spriteSheet: ELDAR_SCORPION.SPK
    corpseBattle:
      - STR_ELDAR_SCORPION_CORPSE_P
    layersDefaultPrefix: "1"
    layersSpecificPrefix:
      1: ELDARSCORPION
      2: SCORPION_HELMET
      3: ELDARSCORPION_ACCESSORY
    layersDefinition:
