      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 33
      ARMOR_MAX_SUCCESSFUL_DODGES: 3

  - type: STR_ELDAR_ARMOR4_P_SHIELD        # DIRE AVANGER
    refNode: *AVENGER_ARMOR
    storeItem: STR_ELDAR_SHIELD
    builtInWeapons:
