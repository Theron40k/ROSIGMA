extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

# STRUCTURE of this file
#
# PLEASE order the ARMORS based on the first unit in this tier order that can use the armor
#
# ELDAR.TIER1 # GUARDIANS
# ELDAR.TIER2 # ASPECT WARRIORS (path of the warrior)
# ELDAR.TIER3 # EXARCH / AUTARCH
# ELDAR.TIER2_PSY # PSY WARRIORS (path of the psyker)
# ELDAR.TIER3_PSY # PSY WARRIORS (Mastery of psychic power)
# ELDAR.TIER4 # special units (example: avatar of khaine)
# ELDAR.TIER3_MIXED # Path of the warlock
# ELDAR.WRAITHGUARD # Wraithguards

armors:
# ELDAR.TIER1 # GUARDIANS

  - &GUARDIAN_ARMOR
    type: STR_ELDAR_ARMOR_GUARDIAN_PLAYER
    storeItem: STR_NONE
    visibilityAtDay: 40
    visibilityAtDark: 30
    frontArmor: 60
    sideArmor: 50
    rearArmor: 40
    underArmor: 40
    drawingRoutine: 0
    damageModifier:  # ELDAR ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 0.5  # FLAMES
      - 1.0  # HE
      - 0.7  # LASCANON
      - 0.7  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 0.5  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.0  # MELTA
    loftempsSet: [3]
    units:
      - STR_ELDAR_GUARDIAN_PLAYER
    tags:
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 2
    spriteSheet: ELDAR_GUARDIAN.SPK
    ufopediaType: STR_ELDAR_ARMOR
    customArmorPreviewIndex: 261
    corpseBattle:
      - STR_ELDAR_GUARDIAN_CORPSE_P
    layersDefaultPrefix: "1"
    layersSpecificPrefix:
      1: ELDARG
      2: GUARDIAN_HELMET
      3: ELDARG_ACCESSORY
    layersDefinition:
      M0: ["", "ELDAR", "OPENHELMET_M1", "ACCESSORY11"]
      M1: ["", "ELDAR", "OPENHELMET_M2", "ACCESSORY1"]
      M2: ["", "ELDAR", "CLOSEDHELMET2", "ACCESSORY2"]
      M3: ["", "ELDAR", "CLOSEDHELMET3", "ACCESSORY12"]
      M4: ["", "ELDAR", "CLOSEDHELMET4", "ACCESSORY3"]
      M5: ["", "ELDAR", "CLOSEDHELMET5", "ACCESSORY4"]
      M6: ["", "ELDAR", "CLOSEDHELMET1", "ACCESSORY5"]
      M7: ["", "ELDAR", "CLOSEDHELMET2", "ACCESSORY6"]
      M8: ["", "ELDAR", "CLOSEDHELMET3", "ACCESSORY7"]
      M9: ["", "ELDAR", "CLOSEDHELMET4", "ACCESSORY8"]
      M10: ["", "ELDAR", "CLOSEDHELMET5", "ACCESSORY9"]
      M11: ["", "ELDAR", "CLOSEDHELMET1", "ACCESSORY10"]
      F0: ["", "ELDAR_F", "OPENHELMET_F1", "ACCESSORY11"]
      F1: ["", "ELDAR_F", "OPENHELMET_F2", "ACCESSORY5"]
      F2: ["", "ELDAR_F", "CLOSEDHELMET1", "ACCESSORY12"]
      F3: ["", "ELDAR_F", "CLOSEDHELMET2", "ACCESSORY7"]
      F4: ["", "ELDAR_F", "CLOSEDHELMET3", "ACCESSORY6"]
      F5: ["", "ELDAR_F", "CLOSEDHELMET4", "ACCESSORY11"]
      F6: ["", "ELDAR_F", "CLOSEDHELMET1", "ACCESSORY1"]
      F7: ["", "ELDAR_F", "CLOSEDHELMET2", "ACCESSORY2"]
      F8: ["", "ELDAR_F", "CLOSEDHELMET3", "ACCESSORY3"]
      F9: ["", "ELDAR_F", "CLOSEDHELMET4", "ACCESSORY4"]
      F10: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY12"]
      F11: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY8"]

  - type: STR_ELDAR_ARMOR_GUARDIAN_SHIELD_PLAYER        # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    storeItem: STR_ELDAR_SHIELD
    spriteSheet: ELDARDR21S.PCK
    customArmorPreviewIndex: 250
    builtInWeapons:
      - AUX_ELDAR_SHIELD
    stats: #some stats changes for the shield
      health: 0
      bravery: 10
      firing: -3
      throwing: -3
    tags:
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 10
      ARMOR_ENERGY_SHIELD_DECAY: 10
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

  - type: STR_ELDAR_ARMOR_GUARDIAN_HEALER_PLAYER        # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    customArmorPreviewIndex: 262
    builtInWeapons:
      - AUX_ELDAR_KIT
    stats: #some stat changes for the medikit encumberance
      stamina: 3
      bravery: 5
      firing: -3
      throwing: -3
      melee: 3

  - &RANGER_ARMOR
    type: STR_ELDAR_RANGER_ARMOR_P # Eldar Ranger Scout Armor
    storeItem: STR_NONE
    visibilityAtDay: 40
    visibilityAtDark: 30
    camouflageAtDay: 20  # you need to be 20 tiles closer than max vision range to see this unit in the light
    camouflageAtDark: 15  # you need to be 10 tiles closer than max vision range (at night!) to see this unit in the dark
    antiCamouflageAtDay: 10
    antiCamouflageAtDark: 10
    heatVision: 20
    frontArmor: 60
    sideArmor: 50
    rearArmor: 40
    underArmor: 40
    drawingRoutine: 0
    damageModifier:  # ELDAR ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 0.5  # FLAMES
      - 1.0  # HE
      - 0.7  # LASCANON
      - 0.7  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 0.5  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.0  # MELTA
    loftempsSet: [3]
    units:
      - STR_ELDAR_RANGER_PLAYER
    tags:
      UNIT_TYPE_XENO: 1
      UNIT_TYPE_ELDAR: 1
      UNIT_TYPE_LIVING: 1
      DODGE_CHANCE: 25
      ARMOR_MAX_SUCCESSFUL_DODGES: 1
    spriteSheet: ELDAR_RANGER.SPK
    #ufopediaType: STR_ELDAR_ARMOR # TODO: add as regular ufopedia in the right file
    customArmorPreviewIndex: 260
    corpseBattle:
      - STR_ELDAR_RANGER_CORPSE_P
    layersDefaultPrefix: "1"
    layersSpecificPrefix:
      1: ELDAR_RGR
      2: RANGER_HELMET
      3: ELDAR_RGR_ACCESSORY
    layersDefinition:
      M0: ["", "ELDAR", "OPENHELMET_M2", "ACCESSORY1"]
      M1: ["", "ELDAR", "OPENHELMET_M1", "ACCESSORY2"]
      M2: ["", "ELDAR", "OPENHELMET_M2", "ACCESSORY3"]
      M3: ["", "ELDAR", "OPENHELMET_M1", "ACCESSORY4"]
      M4: ["", "ELDAR", "CLOSEDHELMET1", "ACCESSORY5"]
      M5: ["", "ELDAR", "CLOSEDHELMET2", "ACCESSORY6"]
      M6: ["", "ELDAR", "CLOSEDHELMET3", "ACCESSORY7"]
      M7: ["", "ELDAR", "CLOSEDHELMET4", "ACCESSORY8"]
      M8: ["", "ELDAR", "CLOSEDHELMET5", "ACCESSORY9"]
      M9: ["", "ELDAR", "CLOSEDHELMET4", "ACCESSORY10"]
      M10: ["", "ELDAR", "CLOSEDHELMET1", "ACCESSORY11"]
      M11: ["", "ELDAR", "CLOSEDHELMET2", "ACCESSORY12"]
      M12: ["", "ELDAR", "CLOSEDHELMET3", "ACCESSORY1"]
      F0: ["", "ELDAR_F", "OPENHELMET_F1", "ACCESSORY12"]
      F1: ["", "ELDAR_F", "OPENHELMET_F2", "ACCESSORY11"]
      F2: ["", "ELDAR_F", "OPENHELMET_F1", "ACCESSORY10"]
      F3: ["", "ELDAR_F", "OPENHELMET_F2", "ACCESSORY9"]
      F4: ["", "ELDAR_F", "CLOSEDHELMET1", "ACCESSORY8"]
      F5: ["", "ELDAR_F", "CLOSEDHELMET2", "ACCESSORY7"]
      F6: ["", "ELDAR_F", "CLOSEDHELMET3", "ACCESSORY6"]
      F7: ["", "ELDAR_F", "CLOSEDHELMET4", "ACCESSORY5"]
      F8: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY4"]
      F9: ["", "ELDAR_F", "CLOSEDHELMET3", "ACCESSORY3"]
      F10: ["", "ELDAR_F", "CLOSEDHELMET4", "ACCESSORY2"]
      F11: ["", "ELDAR_F", "CLOSEDHELMET5", "ACCESSORY1"]
      F12: ["", "ELDAR_F", "CLOSEDHELMET1", "ACCESSORY11"]
    stats: #some stat changes for ranger
      firing: 5
    builtInWeapons:
      - STR_RANGER_LONG_RIFLE
      - STR_RANGER_LONG_RIFLE_MAG_FIXED

  - type: STR_ELDAR_RANGER_SNIPER_ARMOR_P
    refNode: *RANGER_ARMOR
    antiCamouflageAtDay: 5
    antiCamouflageAtDark: 5
    units:
      - STR_ELDAR_RANGER_PLAYER
    stats: #stats for sniper
      firing: 10
    builtInWeapons:
      - STR_RANGER_LONG_RIFLE_SCOPED
      - STR_RANGER_LONG_RIFLE_MAG_FIXED

# DEPRECATED. in future version (3.4 onward) please add - delete: name to keep rosigma clean

  - type: STR_ELDAR_ARMOR_M               # GUARDIAN
    refNode: *GUARDIAN_ARMOR
    units:
      - STR_ELDAR_M

  - type: STR_ELDAR_ARMOR_M_SHIELD        # GUARDIAN
    refNode: *GUARDIAN_ARMOR
