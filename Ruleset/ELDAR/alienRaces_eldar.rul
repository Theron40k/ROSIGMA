alienRaces:

#races list:

# example from tau alien races list
  # - id: STR_REDEMPTIONIST_START_GV  # Beginner Redemptionist Crusaders
  #   retaliationMissionWeights:
  #     0:
  #       STR_ALIEN_RETALIATION: 100
  #   retaliationAggression: -100
  #   membersRandom:
  #     - [STR_REDEMPTIONIST_T1_GV, STR_FRATERIS_MILITIA_VETERAN_AI] # 0 Commander
  #     - [STR_REDEMPTIONIST_T1_GV, STR_FRATERIS_MILITIA_VETERAN_AI] # 1 Leader
  #     - [STR_REDEMPTIONIST_T1_GV, STR_FRATERIS_MILITIA_VETERAN_AI] # 2 Engineer
  #     - [STR_REDEMPTIONIST_T0_GV, STR_FRATERIS_MILITIA_AI] # 3 Medic
  #     - [STR_REDEMPTIONIST_T0_GV, STR_FRATERIS_MILITIA_AI] # 4 Navigator
  #     - [STR_REDEMPTIONIST_T0_GV, STR_FRATERIS_MILITIA_AI] # Soldier
  #     - [STR_REDEMPTIONIST_T0_GV] # 6 Hangers on
  #     - [STR_REDEMPTIONIST_T0_GV] # 7 Big guy

  - id: STR_SLAANESH_CORRUPTED_GANGERS #gangers mixed in with slaanesh low level troops
    retaliationMissionWeights:
      0:
        STR_ALIEN_RETALIATION: 100
    retaliationAggression: -100
    membersRandom:
      - [STR_GANGERBASE_GOLIATH_AI] # 0 Commander
      - [STR_SLAANESH_GUARD_F, STR_SLAANESH_GUARD_M] # 1 Leader
      - [STR_GANGEROUSAI] # 2 Engineer
      - [STR_CHAOSCULT_SOLDIERM_LV1_AI, STR_CHAOSCULT_SOLDIERF_LV1_AI] # 3 Medic
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI] # 4 Navigator
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_CHAOSCULT_SOLDIERM_LV1_AI, STR_CHAOSCULT_SOLDIERF_LV1_AI] # 5 Soldier
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI] # 6 Hangers on
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_CHAOSCULT_OGRYN_AI] # 7 Big guy

