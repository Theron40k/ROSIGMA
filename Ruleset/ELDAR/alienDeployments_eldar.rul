alienDeployments:

    # month 0 ganger base for chaos cult

  - type: STR_GANGER_BASE_CHAOSCORRUPTED
    markerIcon: 54
    #baseSelfDestructCode: STR_NOT_CHAOSCULT #STR_THE_IMPERIAL_LAW_STRATEGY
    terrains:
      - MUNDAINDUSTRIALURBANDIO
      #- CULTIST_TEMPLE
    script: MUNDAINDUSTRIALURBANDIO
    alienBase: true
    objectiveType: 100
    objectiveComplete: [STR_GANGER_BASE_DESTROYED, 250]
    objectivePopup: STR_GANGER_BASE_KILLED
    data:
      - alienRank: 0
        lowQty: 1
        highQty: 2
        dQty: 1
        percentageOutsideUfo: 0
        itemSets: &emptyItemSets [[], [], []]
      - alienRank: 1
        lowQty: 2
        highQty: 4
        dQty: 3
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 2
        lowQty: 2
        highQty: 4
        dQty: 2
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 3
        lowQty: 3
        highQty: 6
        dQty: 4
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 4
        lowQty: 3
        highQty: 3
        dQty: 3
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 5
        lowQty: 3
        highQty: 6
        dQty: 3
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 6
        lowQty: 3
        highQty: 3
        dQty: 3
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 7
        lowQty: 3
        highQty: 6
        dQty: 4
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
    briefing:
      cutscene: CULTBASE
      music: gmstory2
      title: STR_GANGER_BASE_ASSAULT
      textOffset: -16
      background: GANGERBASE.SCR
      showTarget: false
      desc: STR_GANGER_BASE_CHAOSCORRUPTED_ASSAULT_BRIEFING
    missionBountyItem: STR_KILLPOINT_TOKEN
    missionBountyItemCount: 100
    markerName: STR_GANGER_BASE_SITE
    genMissionRaceFromAlienBase: true
    genMission:
      STR_ALIEN_SABOTAGECHAOSCULT: 12
      STR_RIOTCHAOSCULT: 20
      STR_RIOTCHAOSCULTALTERNATE: 20
      STR_GANGERSCITYCONVOYDEF: 20
      STR_GANGERSCITYCONVOYALT: 20
      STR_TS_GANGER_BASE_START_ELDAR: 8
    genMissionFreq: 3
    genMissionLimit: 10000
    width: 50
    length: 50
    height: 12
    points: 0
    #unlockedResearch: STR_ENDGANGERSBASE

  - type: STR_ALIEN_BASE_ASSAULT_SLAANESH_ELDAR                       # RANK0  # RANK1
    randomRace: [STR_SLAANESH_PALACE_ELDARS_LV1]
    alienBase: true    # this is only to tell new battle mode what to do with this deployment
    markerIcon: 7
    markerName: STR_SLAANESH_BASE
    data:
      - alienRank: 0
        lowQty: 1  # 0
        highQty: 1  # 2
        dQty: 1
        percentageOutsideUfo: 25
        itemSets: *emptyItemSets
      - alienRank: 1
        lowQty: 2  # 1
        highQty: 2  # 3
        dQty: 2
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 2  # Engineer
        lowQty: 3
        highQty: 3
        dQty: 3
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 3  # Medic
        lowQty: 2  # 1
        highQty: 2  # 2
        dQty: 2
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 4  # Navigator
        lowQty: 3
        highQty: 6
        dQty: 4
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 5 # Soldiers
        lowQty: 4
        highQty: 8
        dQty: 6
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 6
        lowQty: 8
        highQty: 12
        dQty: 10
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 7
        lowQty: 12
        highQty: 16
        dQty: 14
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
    width: 60
    length: 60
    height: 9
    terrains:
      - ALART_SLAAN
    script: SLAANESH_BASE_PART1
    nextStage: STR_ALIEN_BASE_ASSAULT2_SLAANESH_ELDAR
    briefing:
      cutscene: CHAOSBASE
      music: gmstory2
      title: STR_ALIEN_BASE_ASSAULT_SLAANESH
      textOffset: -16
      background: BACK01.SCR
      showTarget: false
      desc: STR_ALIEN_BASE_ASSAULT_SLAANESH_BRIEFING
    objectiveType: 3
    genMission:
      STR_SLAAN_SUPPLY: 80
      STR_SLAAN_PATROL: 20
      STR_TERROR_MISSION_SLAAN: 20
      STR_DEFILER_RETALIATION: 5
      STR_SLAANESH_RETALIATION: 10
      STR_SLAANESH_ABDUCTION_HARD: 15  # gotta abduct those slaves
      STR_ALIEN_INFILTRATION_SLAANESH_HARD: 10
    genMissionFreq: 5  # 6
    genMissionLimit: 10000  # was 4 in OXCE_40k
    # genMissionLimit: 4                 # new attribute, allows specifying how many genMissions can be spawned in total by one base, default 1000
    baseDetectionRange: 600            # base radar range, in nautical miles
    baseDetectionChance: 50            # base radar chance (once every 10 minutes), in percent
    huntMissionMaxFrequency: 1440  # 300       # generate hunt mission max every 300 minutes (= 5 hours)
    huntMissionWeights:                # which hunt mission to generate, based on months passed and weights
      0:
        STR_SLAAN_INTERCEPTION: 100
    objectiveComplete: [STR_ALIEN_BASE_CONTROL_DESTROYED, 1000]
    objectiveFailed: [STR_ALIEN_BASE_CONTROL_FAILED, -500]
    abortPenalty: 500


