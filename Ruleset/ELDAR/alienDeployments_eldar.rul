      - alienRank: 3  # Medic
        lowQty: 2  # 1
        highQty: 2  # 2
        dQty: 2
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 4  # Navigator
        lowQty: 4
