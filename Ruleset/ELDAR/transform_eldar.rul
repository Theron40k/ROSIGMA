      - STR_HIGHTIER_PREREQ
      - STR_ELDAR_DIRE_AVENGER_EXARCH_RESEARCH
    cost: 50000
    #TESTING minRank: 1
    producedSoldierType: STR_ELDAR_AVENGEREX_P
    keepSoldierArmor: false
    allowsDeadSoldiers: false
    allowsWoundedSoldiers: true
    allowsLiveSoldiers: true
    allowedSoldierTypes:
      - STR_ELDAR_AVANGER_MF
    # requiredMinStats: # rebalanced, kept commented for testing
    #   reactions: 85
    #   firing: 90
    resetRank: true
    percentOverallStatChange:
      tu: 10
      stamina: 10
      health: 20
      bravery: 20
      reactions: 0
      firing: 20
      throwing: 5
      strength: 10
      psiStrength: 10
      psiSkill: 10
      melee: 0
    soldierBonusType: STR_RUNE_OF_WARDING

  - name: STR_PROMOTE_TO_AUTARCH
    # FIXME: requiresBuyBaseFunc: [ASPECT]
    requires:
      - STR_HIGHTIER_PREREQ
      - STR_ELDAR_AUTARCH_EXARCH_RESEARCH
    cost: 50000
    minRank: 1
    producedSoldierType: STR_ELDAR_AUTARCH_PLAYER
