      - STR_PROMOTE_BEGIN_AUTARCH_PATH
      - STR_PROMOTE_TO_SCORPION_AUTARCH
      - STR_PROMOTE_TO_BANSHEE_AUTARCH
      - STR_PROMOTE_TO_REAPER_AUTARCH
      - STR_PROMOTE_TO_DIREAVENGER_AUTARCH
      - STR_PROMOTE_TO_DRAGON_AUTARCH
      - STR_PROMOTE_TO_SPIDER_AUTARCH
    #requiredMinStats:
    #  firing: 65
    resetRank: true
    # requiredCommendations:
    #   STR_LONG_SERVICE_TIME: 0
    percentOverallStatChange:
      tu: 5
      stamina: 5
      health: 5
      bravery: 5
      reactions: 5
      firing: 5
      throwing: 5
      strength: 5
      psiStrength: 5
      psiSkill: 5
      melee: 5
    soldierBonusType: STR_RUNE_OF_COMMAND_AUTARCH

