  - &ELDAR_TRANSFORMATION_SCORPION
    name: STR_PROMOTE_TO_SCORPION
    # FIXME: requiresBuyBaseFunc: [ASPECT]
    requires:
      - STR_ELDAR_ASPECT_RESEARCH
      - STR_ELDAR_SCORPION_RESEARCH
    cost: 20000
    minRank: 1
    producedSoldierType: STR_ELDAR_SCORPION_M
    keepSoldierArmor: false
    allowsDeadSoldiers: false
    allowsWoundedSoldiers: true
    allowsLiveSoldiers: true
    forbiddenPreviousTransformations:
      - STR_PROMOTE_BEGIN_AUTARCH_PATH
    allowedSoldierTypes:
      - STR_ELDAR_M
      - STR_ELDAR_GUARDIAN_PLAYER
      - STR_ELDAR_RANGER_PLAYER
    requiredMinStats:
      bravery: 70
      melee: 50
    percentOverallStatChange:
      tu: 10
      stamina: 20
      health: 0
      bravery: 0
      reactions: 20
      firing: 0
      throwing: 0
      strength: 0
      psiStrength: 0
      psiSkill: 0
      melee: 20
    soldierBonusType: STR_RUNE_OF_VIGOR

