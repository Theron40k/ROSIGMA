soldierTransformation:
#----------------
#STRUCTURE:
#TIER1.transformations #internal tier 1 transformation to gain some bonuses
#TIER2.transformations #transformation from tier 1 to tier 2 (path of the warrior)
#TIER3.transformations #transformation from tier 2 to tier 3 (exarch/autarch)
#TIER4.transformations
#TIER2.PSI.Transformations #transformation from tier 1 to tier 2 for PSI unit (path of the psyker)
#TIER3.PSI.transformations
#TIER4.PSI.transformations
#TIER3.MIXED.transformations # Path of the warlock
#NOTIER.resurrections #resurrection to wraithguard
#-------------

#TIER1.transformations #internal tier 1 transformation to gain some bonuses
  - name: STR_PROMOTE_BEGIN_AUTARCH_PATH
    # FIXME: requiresBuyBaseFunc: [ASPECT]
    requires:
      - STR_ELDAR_ASPECT_RESEARCH
    cost: 20000
    minRank: 1
    producedSoldierType: STR_ELDAR_GUARDIAN_PLAYER
    keepSoldierArmor: false
    allowsDeadSoldiers: false
    allowsWoundedSoldiers: true
    allowsLiveSoldiers: true
    allowedSoldierTypes:
      - STR_ELDAR_M
      - STR_ELDAR_F
      - STR_ELDAR_GUARDIAN_PLAYER
      - STR_ELDAR_RANGER_PLAYER
    forbiddenPreviousTransformations:
      - STR_PROMOTE_BEGIN_AUTARCH_PATH
    requiredMinStats:
      bravery: 70
      #melee: 50
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    flatOverallStatChange:
      tu: 0
      stamina: 0
      health: 0
      bravery: 5
      reactions: 0
      firing: 0
      throwing: 0
      strength: 0
      psiStrength: 0
      psiSkill: 0
      melee: 0
    soldierBonusType: STR_RUNE_OF_COMMAND_START

