manufacture:

  ## CITIZEN CONVERSIONS
  - name: STR_ELDAR_CITIZEN_TO_ENGINEER
    category: STR_ADVANCEMENT
    requires:
      - STR_ELDAR_STRATEGY
    cost: 25000
    time: 1
    refund: true
    producedItems: {}
    spawnedPersonType: STR_ENGINEER
    requiredItems:
      STR_ELDAR_CITIZEN: 1
  - name: STR_ELDAR_CITIZEN_TO_SCIENTIST
    category: STR_ADVANCEMENT
    requires:
      - STR_ELDAR_STRATEGY
    cost: 30000
    time: 1
    refund: true
    producedItems: {}
    spawnedPersonType: STR_SCIENTIST
    requiredItems:
      STR_ELDAR_CITIZEN: 1

### Soldier Manufacture
  - name: STR_CONSCRIPT_ELDAR_GUARDIAN
    category: STR_ADVANCEMENT
    requires:
      - STR_ELDAR_STRATEGY
      - STR_RECRUIT_ELDAR_T1
    space: 0
    time: 100
    cost: 30000
    producedItems: {}
    spawnedPersonType: STR_ELDAR_GUARDIAN_PLAYER
    requiredItems:
      STR_KILLPOINT_TOKEN: 10
    points: 0

  - name: STR_ENLIST_ELDAR_OUTCAST_RANGER
    category: STR_ADVANCEMENT
    requires:
      - STR_RECRUIT_ELDAR_OUTCAST
    space: 0
    time: 200
    cost: 35000
    producedItems: {}
    spawnedPersonType: STR_ELDAR_RANGER_PLAYER
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
      STR_ELDAR_CITIZEN: 1 # For now consider rangers part of the eldar population, this can be changed but requires adjusting costs.
    points: -50 # lose eldar trust for enlisting outcasts

  - name: STR_DIRESWORD_VESSEL_MANUFACTURE
    category: STR_ELDAR_SOULTECH_CATEGORY
    requires:
      - STR_ELDAR_ONLY
      - STR_FORGE_DIRESWORD_VESSEL_RESEARCH
    # requiresBaseFunc: [ELDAROUT] # could be used for taboo soul manipulation eldar technology
    space: 0
    time: 200
    cost: 50000
    points: -50 # less taboo than wraithguard creation and warcrime level weaponry
    requiredItems:
      STR_KILLPOINT_TOKEN: 10     # Nominal amount
      STR_ALIEN_ALLOYS: 30        # Adamantium
    producedItems:
      STR_DIRESWORD_VESSEL: 1

  - name: STR_DIRESWORD_ENSOULED_MANUFACTURE
    category: STR_ELDAR_SOULTECH_CATEGORY
    requires:
      - STR_ELDAR_ONLY
      - STR_FORGE_DIRESWORD_VESSEL_RESEARCH
    # requiresBaseFunc: [ELDAROUT] # could be used for taboo soul manipulation eldar technology
    space: 0
    time: 200
    cost: 100000
    points: -200 # Taking a spirit stone from its resting place in the inifinity circuit is an act of desperation
    requiredItems:
      STR_KILLPOINT_TOKEN: 200     # Should be expensive and overcosted for players who are doing extremely well and want access to soul weapons
      STR_DIRESWORD_VESSEL: 1
    producedItems:
      STR_DIRESWORD: 1

  - name: STR_CRATED_HORNET
    category: STR_CRAFT
    requires:
      - STR_ELDAR_CRAFT_RESEARCH
    space: 0
    time: 100
    cost: 1000
    requiredItems:
      STR_CRATED_HORNET: 1
    producedItems:
      STR_HORNET: 1