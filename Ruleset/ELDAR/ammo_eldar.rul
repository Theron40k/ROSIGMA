extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

items:
  - delete: STR_SHURIKEN_CLIP
  - type: STR_SHURIKEN_CLIP  #                 16200
    categories: [STR_CAT_ELDAR, STR_CAT_TACTICAL]
    damageAlter:  # DA SHURIKEN
      ToArmorPre: 0.1  # was ToArmor, i.e doesn't damage high armor it can't pen, making certain units invincible.
      RandomType: 2  # TFTD [50% - 150%]
      ToHealth: 0.5
      ToStun: 0.2
      ArmorEffectiveness: 0.3
    requires:
      - STR_ELDAR_WEAPONS_ACQUISITION
    requiresBuy: []  # Already requires the eldar base service
    weight: 5
    requiresBuyBaseFunc: [ELDAROUT]
    size: 0.1
    costBuy: 500
    costSell: 250
    bigSprite: {mod: 40k, index: 393}
    floorSprite: {mod: 40k, index: 245}
    handSprite: {mod: 40k, index: 464}
    hitSound: 1874 #{mod: 40k, index: 708} old sound
    hitAnimation: {mod: 40k, index: 26}
    explosionSpeed: 5
    power: 50
    damageType: 1
    clipSize: 20
    battleType: 2
    armor: 30
    attraction: 1
    listOrder: 16115

  - type: STR_RANGER_LONG_RIFLE_MAG #TEMPORARY copied STR_TAU_PULSE_MAG
    categories: [STR_CAT_ELDAR, STR_CAT_SNIPER]
    requires:
      - STR_RECRUIT_ELDAR_OUTCAST
    requiresBuy: []
    requiresBuyBaseFunc: [ELDAROUT]
    size: 0.2
    weight: 1 #light weight
    invHeight: 2
    invWidth: 1
    bigSprite: 4859
    floorSprite: 4859
    handSprite: 4874
    bulletSprite: {mod: 40k, index: 12}
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    costBuy: 2000
    costSell: 1000
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    explosionSpeed: 10
    bulletSpeed: 25 # slow it down some
    battleType: 2
    clipSize: 20
    power: 95
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.1-0.3  # melts some armor on the way in
      # ArmorEffectiveness: 0.9  # some armor penetration
    listOrder: 16620

  - type: STR_FUSION_AMMO  # 16550   # TEMPORARY MELTAGUN HARMONIC AMMO
    categories: [STR_CAT_ELDAR, STR_CAT_TACTICAL, STR_CAT_MELTA]
    requiresBuy: []  # Already requires the eldar base service
    requiresBuyBaseFunc: [ELDAROUT]
    requires:
      - STR_ELDAR_WEAPONS_ACQUISITION
      - STR_FUSION_TECH_RESEARCH
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 6
    vaporProbabilitySurface: 18
    size: 0.2
    costBuy: 15000
    costSell: 500
    weight: 3
    bigSprite: 4953
    floorSprite: 4953
    handSprite: 4916
    hitSound: 1882
    hitAnimation: {mod: 40k, index: 110}
    power: 80
    damageType: 11
    damageAlter:  # DA MELTA
      RandomType: 6
      ToArmorPre: 1.0
      ToHealth: 1.6
      ToTile: 6.0
      ToWound: 0.05
      RandomWound: false
      TileDamageMethod: 2
    powerRangeReduction: 7
    powerRangeThreshold: 12.0
    clipSize: 8
    battleType: 2
    invWidth: 1
    invHeight: 2
    armor: 300
    listOrder: 16520

  - type: STR_SMALL_ROCKET_TEMPEST_ELDAR  # eldar tempest rocket launcher clip
    categories: [STR_CAT_ROCKETL, STR_CAT_ELDAR]
    requiresBuyBaseFunc: [ELDAROUT]
    requiresBuy: []
    requires:
      - STR_ELDAR_REAPER_RESEARCH
    size: 0.5
    costBuy: 10000
    costSell: 6000
    bigSprite: 4856
    floorSprite: {mod: 40k, index: 238} #TODO
    handSprite: {mod: 40k, index: 816} # TODO
    bulletSprite: 0
    hitSound: 0
    weight: 12 # 3*4
    power: 60
    damageType: 3
    damageAlter:
      ToArmorPre: 0.2
      ToArmor: 0.15 #low armor stripping damage
      RandomType: 6
      ArmorEffectiveness: 0.9  # concussive
      ToStun: 0.5  # concussive
      ToEnergy: 0.3  # concussive
      ToTime: 0.2  # concussive
      ToTile: 0.75  # high explosive
      ToItem: 0.75  # high explosive
      FixRadius: 4 #lower explosion range from normal rockets
    clipSize: 3
    battleType: 2
    invWidth: 2
    invHeight: 2
    listOrder: 12130

  - type: STR_LARGE_ROCKET_ELDAR  # Reaper Rocket
    categories: [STR_CAT_ROCKETL, STR_CAT_ELDAR]
    requiresBuyBaseFunc: [ELDAROUT]
    requiresBuy: []
    requires:
      - STR_ELDAR_REAPER_RESEARCH
    power: 120  # +20 over krak rocket
    size: 0.1
    battleType: 2
    invWidth: 2
    invHeight: 1
    weight: 5  # was 8
    costBuy: 8000
    costSell: 5000
    bigSprite: 4855
    floorSprite: 4855
    handSprite: {mod: 40k, index: 448}  # todo: improvement needed
    bulletSprite: 0
    hitSound: 0
    hitAnimation: 0
    clipSize: 1
    damageType: 3
    damageAlter: # Krak
      ResistType: 1
      RandomType: 6  # gaussian
      ToHealth: 0.8
      ToArmorPre: 0.3
      ToArmor: 0.3
      ToTile: 1.0
      ToItem: 1.0
      ArmorEffectiveness: 0.5
      FixRadius: 1
    tags:
      DAMAGE_RESIST_PENETRATION_PERCENT: 50

