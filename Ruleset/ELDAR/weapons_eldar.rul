  - type: STR_AVENGER_CATAPULT
    refNode: *ELDAR_SHURIKEN_WEAPON_TEMPLATE
    weight: 20
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
    # Avenger Research
    costBuy: 15000
    costSell: 5000
    bigSprite: 4884
    floorSprite: 4884
    handSprite: 1562
    compatibleAmmo:
      - STR_SHURIKEN_CLIP
      - STR_AVENGER_SHURIKEN_CLIP
    accuracyMultiplier:
      firing: 0.5
      reactions: 0.7 # makes similar accuracy at lowest reactions, gives avengers extra accuracy at max cap
    invWidth: 2
    invHeight: 3
    snapRange: 14
    autoRange: 10
    listOrder: 16103
    tags:
      REACTION_MULTIPLIER: 120 # 20% Avenger Bonus

