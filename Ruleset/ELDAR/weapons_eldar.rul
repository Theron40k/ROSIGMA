#--- ELDAR.GRENADES ---

  - delete: STR_ELDAR_GRENADE
  - type: STR_ELDAR_GRENADE  # Eldar Plasma Granade          16320
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
      - STR_MIDTIER_PREREQ
    requiresBuyBaseFunc: []
    categories: [STR_CAT_GRENADES, STR_CAT_TACTICAL, STR_CAT_ELDAR]
    weight: 2
    primeSound: 2426
    throwRange: 18
    fuseType: -2
    costThrow:
      time: 55
      energy: 5
    costPrime:
      time: 5
    costUnprime:
      time: 5
    unprimeActionName: STR_UNPRIME_GRENADE
    flatThrow:
      time: false
      energy: true
    flatPrime:
      time: false
      energy: true
    damageType: 5
    power: 90
    damageAlter: # DA PLASMA
      RandomType: 6
      ToArmorPre: 0.2  # melts some armor on the way in
      ArmorEffectiveness: 0.75  # *** PLASMA rebalance
      FireThreshold: 70  # can ignite at high damage
      FixRadius: 5
    noLOSAccuracyPenalty: 75  # indirect fire weapon
    size: 0.1
    costBuy: 20000
    costSell: 5000
    bigSprite: {mod: 40k, index: 397}
    floorSprite: {mod: 40k, index: 252}
    handSprite: {mod: 40k, index: 888}
    battleType: 4
    invWidth: 1
    invHeight: 2
    blastRadius: 5
    explosionHitSound: {mod: 40k, index: 690}
    hitAnimation: {mod: 40k, index: 112} #XPLASMA
    listOrder: 16320

  - delete: STR_ELDAR_MGRENADE
  - type: STR_ELDAR_MGRENADE  # eldar melta grenade         16310
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
      - STR_MELTAGUN_TECH
      - STR_MIDTIER_PREREQ
    requiresBuyBaseFunc: []
    categories: [STR_CAT_GRENADES, STR_CAT_TACTICAL, STR_CAT_ELDAR]
    throwRange: 15
    primeSound: 2426
    weight: 4
    fuseType: -2
    costThrow:
      time: 60
      energy: 20
    costPrime:
      time: 5
    costUnprime:
      time: 5
    unprimeActionName: STR_UNPRIME_GRENADE
    flatThrow:
      time: false
      energy: true
    flatPrime:
      time: false
      energy: true
    flatUnprime:
      time: false
      energy: true
    noLOSAccuracyPenalty: 75  # indirect fire weapon
    power: 140
    damageType: 11
    damageAlter:
      RandomType: 6
      ToArmorPre: 1.0  # it's a melta grenade; it will melt armor
      ToTile: 1.0
      ToItem: 1.0
      ToArmor: 0.0
      ToHealth: 0.7
      ToWound: 0.05
      RadiusReduction: 15 # melta explosions decay at twice the normal rate; coheres somewhat better than Imperium melta
      RandomWound: false
      FireThreshold: 0
      FixRadius: 5
    size: 0.1
    costBuy: 50000
    costSell: 15000
    bigSprite: {mod: 40k, index: 398}
    floorSprite: {mod: 40k, index: 253}
    handSprite: {mod: 40k, index: 896}
    battleType: 4
    invWidth: 2
    invHeight: 2
    blastRadius: 4
    listOrder: 16310

