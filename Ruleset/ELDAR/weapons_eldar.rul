  - delete: STR_CATAPULT
  - &ELDAR_SHURIKEN_WEAPON_TEMPLATE
    type: STR_CATAPULT
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
    requiresBuyBaseFunc: []
    weight: 17
    categories: [STR_CAT_ELDAR, STR_CAT_TACTICAL]
