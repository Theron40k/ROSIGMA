#--- ELDAR.WEAPONS ---
  - delete: STR_CATAPULT
  - &ELDAR_WEAPON_TEMPLATE
    type: STR_CATAPULT
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
    requiresBuyBaseFunc: []
    weight: 17
    categories: [STR_CAT_ELDAR, STR_CAT_TACTICAL]
    size: 0.3
    dropoff: 5
    costBuy: 6000
    costSell: 2750
    bigSprite: {mod: 40k, index: 391}
    floorSprite: {mod: 40k, index: 243}
    handSprite: {mod: 40k, index: 832}
    bulletSprite: {mod: 40k, index: 20}
    fireSound: [{mod: 40k, index: 839}, {mod: 40k, index: 840}, {mod: 40k, index: 841}]
    compatibleAmmo:
      - STR_SHURIKEN_CLIP
    accuracySnap: 80
    accuracyAuto: 66
    tuSnap: 25
    tuAuto: 40
    battleType: 1
    twoHanded: true
    invWidth: 2
    invHeight: 3
    armor: 30
    autoShots: 9
    bulletSpeed: 30
    attraction: 1
    confSnap:
      shots: 3
    experienceTrainingMode: 6
    listOrder: 16100

  - type: STR_RANGER_LONG_RIFLE #TEMPORARY COPY STR_TAU_PULSE_RIFLE
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
      - STR_RECRUIT_ELDAR_OUTCAST
    requiresBuyBaseFunc: []
    weight: 7
    categories: [STR_CAT_SNIPER, STR_CAT_ELDAR]
    size: 0.4
    bigSprite: 4857
    floorSprite: 4857
    handSprite: 4858
    bulletSprite: {mod: 40k, index: 12}
    fireSound: [1875, 1876, 1877]
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    reloadSound: 1878
    costBuy: 40000
    costSell: 20000
    explosionSpeed: 10
    bulletSpeed: 100
    accuracyAuto: 70
    accuracySnap: 90
    accuracyAimed: 110
    tuAimed: 70
    tuAuto: 50
    tuSnap: 30
    autoShots: 3
    power: 95
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.1 or 0.3, depending # melts some armor on the way in
    battleType: 1
    twoHanded: true
    oneHandedPenalty: 25
    invWidth: 2
    invHeight: 3
    arcingShot: false
    minRange: 5
    aimRange: 25
    snapRange: 20
    autoRange: 16
    dropoff: 3 #tau rifle has exceptional range
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    kneelBonus: 120
    compatibleAmmo:
      - STR_RANGER_LONG_RIFLE_MAG
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    recover: true
    listOrder: 16600

