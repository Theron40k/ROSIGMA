    hitSound: {mod: 40k, index: 19}
    bulletSprite: {mod: 40k, index: 21}
    explosionHitSound: {mod: 40k, index: 803}
    hitAnimation: 2100
    costSell: 500
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    tuLoad: 5 #quick reload; mainly for underslung
    battleType: 2
    power: 90
    clipSize: 3
    damageType: 6
    damageAlter:
      ArmorEffectiveness: 0.5
      ToStun: 0.5  # was 0.2
      ToTime: 1.0
      ToEnergy: 0.5
      RadiusReduction: 5.0
      ToHealth: 0.05
      ToWound: 0.00
      RandomWound: false
      FixRadius: 3
    noLOSAccuracyPenalty: 75  # indirect fire weapon

