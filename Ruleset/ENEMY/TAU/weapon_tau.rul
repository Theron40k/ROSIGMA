extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

items:
  - type: STR_TAU_DRONE_BURST_CANNON_TWINLINKED
    categories: [STR_CAT_PLASMA, STR_CAT_TACTICAL, STR_CAT_TAU]
    weight: 1
    dropoff: 4 #tau carbine
    bigSprite: 3140
    floorSprite: 949
    handSprite: 864
    bulletSprite: {mod: 40k, index: 12}
    fireSound: 2450
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    explosionSpeed: 10
    bulletSpeed: 30
    accuracyAuto: 60
    accuracySnap: 70
    autoRange: 12
    snapRange: 16
    tuAuto: 50
    tuSnap: 33
    autoShots: 6
    sprayWaypoints: 2
    clipSize: -1
    confSnap:
      name: TAUDRONEGUN_BURST
      shots: 3
      followProjectiles: false   # the camera stays still while shooting (prevents minigun seizures)
    confAuto:
      name: TAUDRONEGUN_AUTO
      followProjectiles: false   # the camera stays still while shooting (prevents minigun seizures)
    # Carbine/rifle/burst cannon fire
    power: 95
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.2 # was 0.3  # melts some armor on the way in
      # ArmorEffectiveness: 0.9  # some armor penetration
    battleType: 1
    twoHanded: false
    invWidth: 2
    invHeight: 3
    arcingShot: false
    recover: false
    fixedWeapon: true
    fixedWeaponShow: false  # do not appear in the drone sprites hand
    shotgunSpread: 1  # twin linked
    shotgunBehavior: 1  # twin linked
    shotgunPellets: 2
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;

  - &STR_TAU_PULSE_RIFLE_TEMPLATE
    type: STR_TAU_PULSE_RIFLE
    categories: [STR_CAT_PLASMA, STR_CAT_TACTICAL, STR_CAT_TAU]
    size: 0.4
    requires:
      - STR_TAU_XENOTECH
    weight: 7
    bigSprite: 3144
    floorSprite: 3141
    handSprite: 3700
    bulletSprite: {mod: 40k, index: 12}
    fireSound: 2450
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    reloadSound: 2451
    costSell: 20000
    explosionSpeed: 10
    bulletSpeed: 100
    accuracyAuto: 70
    accuracySnap: 90
    accuracyAimed: 110
    tuAimed: 70
    tuAuto: 50
    tuSnap: 30
    autoShots: 3
    power: 95
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.1 or 0.3, depending # melts some armor on the way in
    battleType: 1
    twoHanded: true
    oneHandedPenalty: 25
    invWidth: 2
    invHeight: 3
    arcingShot: false
    minRange: 5
    aimRange: 25
    snapRange: 20
    autoRange: 16
    dropoff: 3 #tau rifle has exceptional range
    recover: true
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    kneelBonus: 120
    compatibleAmmo:
      - STR_TAU_PULSE_MAG
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    tags:
      ITEM_AIMED_ACCURACY_POWER_BONUS_PERCENT: 25  # Battle rifle
      ITEM_SNAP_ACCURACY_POWER_BONUS_PERCENT: 10  # Battle rifle

  - type: STR_TAU_PULSE_RIFLE_EXPORT
    refNode: *STR_TAU_PULSE_RIFLE_TEMPLATE #nerfed in basically every way
    requires:
      - STR_TAU_TRADING
    requiresBuy:
      - STR_TAU_TRADING
      - STR_NOT_TAU_GUEVESA_TRADING   # stop buying old one when new one arrives
    requiresBuyBaseFunc: [TRADE]
    size: 0.4
    bigSprite: 3153
    floorSprite: 3154
    handSprite: 3740
    aimRange: 22
    snapRange: 18
    autoRange: 12
    accuracyAuto: 50
    accuracySnap: 80
    accuracyAimed: 100
    autoShots: 2
    costBuy: 500000 #absurdly expensive
    compatibleAmmo:
      - STR_TAU_PULSE_MAG_EXPORT

  - type: STR_TAU_PULSE_RIFLE_EXPORT_GUEVESA
    refNode: *STR_TAU_PULSE_RIFLE_TEMPLATE
    requires:
      - STR_TAU_GUEVESA_TRADING
    requiresBuy:
      - STR_TAU_GUEVESA_TRADING
    requiresBuyBaseFunc: [TRADE]
    size: 0.4
    bigSprite: 3153
    floorSprite: 3154
    handSprite: 3740
    aimRange: 22
    snapRange: 18
    autoRange: 12
    accuracyAuto: 60
    accuracySnap: 85
    accuracyAimed: 105
    autoShots: 2
    costBuy: 200000 # bros pay 40%
    compatibleAmmo:
      - STR_TAU_PULSE_MAG_EXPORT_GUEVESA

  - &STR_TAU_PULSE_AMMO_TEMPLATE
    type: STR_TAU_PULSE_MAG #universal ammo
    size: 0.05
    requires:
      - STR_TAU_XENOTECH
    weight: 1 #light weight
    invHeight: 1
    invWidth: 1
    bigSprite: 3149
    floorSprite: 3150
    handSprite: 3703
    bulletSprite: {mod: 40k, index: 12}
    fireSound: 2450
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    costSell: 1000
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    explosionSpeed: 10
    bulletSpeed: 25 # slow it down some
    battleType: 2
    clipSize: 20
    power: 95
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.1-0.3  # melts some armor on the way in
      # ArmorEffectiveness: 0.9  # some armor penetration

  - type: STR_TAU_PULSE_MAG_EXPORT
    refNode: *STR_TAU_PULSE_AMMO_TEMPLATE
    requires:
      - STR_TAU_TRADING
    requiresBuy:
      - STR_TAU_TRADING
      - STR_NOT_TAU_GUEVESA_TRADING   # stop buying old one when new one arrives
    requiresBuyBaseFunc: [TRADE]
    bigSprite: 3152
    floorSprite: 3151
    handSprite: 3704
    clipSize: 12 #severely limited
    # doesn't hit as hard
    power: 85
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.15 # was 0.1-0.3  # melts some armor on the way in
    costBuy: 5000
    costSell: 1000

  - type: STR_TAU_PULSE_MAG_EXPORT_GUEVESA
    refNode: *STR_TAU_PULSE_AMMO_TEMPLATE
    requires:
      - STR_TAU_GUEVESA_TRADING
    requiresBuy:
      - STR_TAU_GUEVESA_TRADING
    requiresBuyBaseFunc: [TRADE]
    bigSprite: 3152
    floorSprite: 3151
    handSprite: 3704
    clipSize: 16
    # doesn't hit as hard
    power: 90
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.15 # was 0.1-0.3  # melts some armor on the way in
    costBuy: 4000 # friends pay 40% per shot
    costSell: 500

  - type: STR_TAU_PULSE_BLASTER_MAG
    refNode: *STR_TAU_PULSE_AMMO_TEMPLATE
    power: 95
    clipSize: 16
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 7   # random means some pellets will roll high
      ToArmorPre: 0.2 # was 0.2 # was 0.3  # melts some armor on the way in
      ArmorEffectiveness: 0.9  # the blaster retains armor penetration
    shotgunBehavior: 1
    shotgunSpread: 10
    shotgunPellets: 5
    powerRangeReduction: 20.0
    powerRangeThreshold: 12.0

  - &STR_TAU_PULSE_CARBINE_TEMPLATE
    type: STR_TAU_PULSE_CARBINE
    categories: [STR_CAT_PLASMA, STR_CAT_ASSAULT, STR_CAT_TAU]
    requires:
      - STR_TAU_XENOTECH
    size: 0.3
    weight: 5
    bigSprite: 3145
    floorSprite: 3146
    handSprite: 3708
    bulletSprite: {mod: 40k, index: 12}
    fireSound: 2450
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    reloadSound: 2451
    costSell: 20000
    explosionSpeed: 10
    bulletSpeed: 30
    accuracyAuto: 60
    accuracySnap: 80
    accuracyAimed: 90
    tuAuto: 40
    tuSnap: 25
    tuAimed: 25
    autoShots: 4
    power: 100
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.2 # was 0.3  # melts some armor on the way in
      # ArmorEffectiveness: 0.9  # some armor penetration
    battleType: 1
    confSnap: # 2 shot burst
      ammoSlot: 0
      name: STR_BURST_SNAP_SHOT
      arcing: false
      shots: 2
    confAuto:
      ammoSlot: 0
      arcing: false
    confAimed:  # Photon Underslung Grenade Launcher
      ammoSlot: 1  # Grenades
      name: STR_LAUNCH_GRENADE
      shortName: STR_LAUNCH_GRENADE_SHORT
      arcing: true
    ammo:
      0:
        compatibleAmmo: [STR_TAU_PULSE_MAG]
      1:
        compatibleAmmo: [STR_TAU_PHOTON_GRENADE_CARBINE]
    twoHanded: true
    oneHandedPenalty: 50
    invWidth: 2
    invHeight: 3
