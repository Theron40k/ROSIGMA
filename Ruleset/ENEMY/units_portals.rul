
units:

  - &STR_DAEMON_PORTAL_TEMPLATE
    type: STR_DAEMON_PORTAL
    stats:
      tu: 100
      stamina: 0
      health: 100
      bravery: 150
      reactions: 40 #for Dark Sermon
      firing: 0
      throwing: 0
      strength: 0
      psiStrength: 100 #can attempt to mind control when it doesn't spawn a demon or blaspheme Event Horizon style
      psiSkill: 100
      melee: 0
    armor: STR_DAEMON_PORTAL_ARMOR
    canPanic: false
    avoidsFire: false
    canBeMindControlled: false
    moraleLossWhenKilled: 0  #it's a portal
    value: 0 #it's a portal
    standHeight: 21
    kneelHeight: 21
    deathSound: {mod: 40k, index: 737}
    intelligence: 0
    aggression: 0
    energyRecovery: 0
    spotter: 1
    moveSound: -1
    capturable: false
    builtInWeaponSets:
      - - STR_DARK_SERMON_PORTAL
      - - STR_DARK_SERMON_PORTAL
      - - STR_DARK_SERMON_PORTAL

  - &STR_DAEMON_PORTAL_LESSER_TEMPLATE
    type: STR_DAEMON_PORTAL_LESSER
    armor: STR_DAEMON_PORTAL_ARMOR_LESSER
    refNode: *STR_DAEMON_PORTAL_TEMPLATE
    stats:
      tu: 100
      stamina: 0
      health: 100
      bravery: 130
      reactions: 30 #for Dark Sermon
      firing: 0
      throwing: 0
      strength: 0
      psiStrength: 100 #can attempt to mind control when it doesn't spawn a demon or blaspheme Event Horizon style
      psiSkill: 80
      melee: 0

  - &STR_DAEMON_PORTAL_MINOR_TEMPLATE
    type: STR_DAEMON_PORTAL_MINOR
    armor: STR_DAEMON_PORTAL_ARMOR_MINOR
    refNode: *STR_DAEMON_PORTAL_TEMPLATE
    stats:
      tu: 100
      stamina: 0
      health: 100
      bravery: 110
      reactions: 20 #for Dark Sermon
      firing: 0
      throwing: 0
      strength: 0
      psiStrength: 100 #can attempt to mind control when it doesn't spawn a demon or blaspheme Event Horizon style
      psiSkill: 60
      melee: 0

