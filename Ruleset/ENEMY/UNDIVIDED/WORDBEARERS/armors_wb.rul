extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

armors:

  - type: STR_WORDBEARER_GALVWARRIOR_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 25
    heatVision: 20
    spriteSheet: WORDBEARERGALVbattle.PCK
    spriteInv: WORDBEARERGALVinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_GALV_CORPSE
    frontArmor: 120
    sideArmor: 110
    rearArmor: 80
    underArmor: 110
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.9  # AP
      - 0.6  # FLAMES
      - 0.7  # HE
      - 0.8  # LASCANON
      - 1.1  # PLASMA
      - 1.1  # STUN
      - 1.1  # MELEE Weakness
      - 1.0  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_POSSESSION_TYPE: 1 #1 means it will spawn STR_WORDBEARER_GALVWARRIORPOSS
      UNIT_POSSESSION_MANIFESTATION_CHANCE: 5 #this is a percent
      INFECTION_RESIST: 50 #is possessed by a daemon
      INTIMIDATION_RESISTANCE: 50 #too zealous to be easily intimidated
      DODGE_CHANCE: 5
      ARMOR_MAX_SUCCESSFUL_DODGES: 1

  - type: STR_WORDBEARER_GALVWARRIOR_POSSARMOR
    visibilityAtDay: 40
    visibilityAtDark: 40 #daemonic
    heatVision: 33 #daemonic
    psiVision: 5 #daemonic
    antiCamouflageAtDay: 5  #Keen senses
    antiCamouflageAtDark: 5  #Keen senses
    spriteSheet: WORDBEARERGALVPOSSbattle.PCK
    spriteInv: WORDBEARERGALVPOSSinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_GALV_POSSCORPSE
    frontArmor: 120
    sideArmor: 110
    rearArmor: 80
    underArmor: 120
    damageModifier:  # CHAOS ARMOR
      - 1.0  # none
      - 0.8  # AP
      - 0.6  # FLAMES
      - 0.7  # HE
      - 1.0  # LASCANON
      - 1.0  # PLASMA
      - 0.9  # STUN
      - 0.9  # MELEE Weakness
      - 0.5  # ACID; Daemons resistant to poison
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    recovery: #these daemons have slow regeneration
      health:
        healthCurrent: 0.1
        fatalWounds: 1
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      ARMOR_OVERWATCH_TU_RESTORED: 50
      INFECTION_RESIST: 100 #is a daemon
      INTIMIDATION_RESISTANCE: 75 #too crazy to be easily intimidated
      DODGE_CHANCE: 10
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

  - type: STR_WORDBEARER_GALVWARRIORELITE_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 30 #artificer armor
    heatVision: 30 #artificer armor
    antiCamouflageAtDay: 5  #Keen senses
    antiCamouflageAtDark: 5  #Keen senses
    spriteSheet: WORDBEARERGALVelitebattle.PCK
    spriteInv: WORDBEARERGALVeliteinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_GALVELITE_CORPSE
    frontArmor: 130 #artificer armor
    sideArmor: 120
    rearArmor: 90
    underArmor: 130
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.9  # AP
      - 0.6  # FLAMES
      - 0.7  # HE
      - 0.8  # LASCANON
      - 1.1  # PLASMA
      - 1.1  # STUN
      - 1.1  # MELEE Weakness
      - 1.0  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_POSSESSION_TYPE: 2 #1 means it will spawn STR_WORDBEARER_GALVWARRIORPOSSELITE
      UNIT_POSSESSION_MANIFESTATION_CHANCE: 10 #this is a percent
      INFECTION_RESIST: 50 #is possessed by a daemon
      INTIMIDATION_RESISTANCE: 50 #too zealous to be easily intimidated
      DODGE_CHANCE: 5
      ARMOR_MAX_SUCCESSFUL_DODGES: 1

  - type: STR_WORDBEARER_GALVWARRIORELITE_POSSARMOR
    visibilityAtDay: 40
    visibilityAtDark: 40 #daemonic
    heatVision: 33 #daemonic
    psiVision: 10 #daemonic
    antiCamouflageAtDay: 10  #Keen senses
    antiCamouflageAtDark: 10  #Keen senses
    spriteSheet: WORDBEARERGALVPOSSelitebattle.PCK
    spriteInv: WORDBEARERGALVPOSSeliteinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_GALVELITE_POSSCORPSE
    frontArmor: 130
    sideArmor: 120
    rearArmor: 90
    underArmor: 130
    damageModifier:  # CHAOS ARMOR
      - 1.0  # none
      - 0.7  # AP
      - 0.6  # FLAMES
      - 0.7  # HE
      - 1.0  # LASCANON
      - 1.0  # PLASMA
      - 0.9  # STUN
      - 0.8  # MELEE Weakness
      - 0.5  # ACID; Daemons innately resist acid/poison
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    allowsKneeling: false  # cant do that
    recovery: #these daemons have slow regeneration
      health:
        healthCurrent: 0.1
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      ARMOR_OVERWATCH_TU_RESTORED: 100
      ARMOR_REGENERATES_WOUNDS: 1
      INFECTION_RESIST: 100 #is a daemon
      INTIMIDATION_RESISTANCE: 75 #too crazy to be easily intimidated
      DODGE_CHANCE: 10
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

  - type: STR_WORDBEARER_DARKAPOSTLE_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 30 #artificer armor
    heatVision: 30 #artificer armor
    antiCamouflageAtDark: 10
    antiCamouflageAtDay: 10
    psiVision: 5
    spriteSheet: WORDBEARERdarkapostlebattle.PCK
    spriteInv: WORDBEARERdarkapostleinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_DARKAPOSTLE_ARMOR_CORPSE
    frontArmor: 130 #artificer armor
    sideArmor: 120
    rearArmor: 100
    underArmor: 130
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.8  # AP
      - 0.5  # FLAMES
      - 0.6  # HE
      - 0.8  # LASCANON
      - 1.0  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 0.9  # ACID
      - 0.0  # SMOKE
      - 0.2  # IMPACT
      - 1.1  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      UNIT_HAS_RUINOUS_BLESSING: 1
      INFECTION_RESIST: 100 #blessed by the dark gods
      INTIMIDATION_RESISTANCE: 75 #zealous convictions
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 25  # Basic energy field (25 * 100 / 25) = 100. Regenerates from 25 (at 0) to 0 (at 100) / Turn
      ARMOR_ENERGY_SHIELD_DECAY: 25
      DODGE_CHANCE: 10
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

    scripts:
      selectUnitSprite: |
        # https://openxcom.org/forum/index.php/topic, 4322.msg75634.html# msg75634
        # and power pack for veterans/scions
        var int temp;
        var int walking;
        var int floating;
        var int isFemale;

        var int numOfFrames;

        unit.isWalking walking;
        unit.isFloating floating;
        unit.getGender isFemale;

        set numOfFrames 6;


        unit.getId temp;

        add temp anim_frame;
        mod temp numOfFrames;
        mul temp 8;


        if eq blit_part blit_torso; # if torso to be drawn
            if eq floating 0;

              set sprite_index 288; # position after female and flying legs (8+8 + some extra offset so it's multiple of 16)
              add sprite_index temp;
              if neq 0 isFemale;
                # using isFemale differently for now;
                set isFemale 8;
                mul isFemale numOfFrames;
                add sprite_index isFemale;
              end;
            end;
        end;

        add sprite_index sprite_offset; # add direction

        return sprite_index;

  - type: STR_WORDBEARER_TERMINATOR_ARMOR
    visibilityAtDay: 40
