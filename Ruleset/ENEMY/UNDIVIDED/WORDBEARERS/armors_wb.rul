    frontArmor: 150
    sideArmor: 140
    rearArmor: 100
    underArmor: 150
    specialWeapon: STR_POWERFIST
    damageModifier:  # TERMINATOR ARMOR
      - 1.0  # none
      - 0.7  # AP;
      - 0.2  # FLAMES; Word Bearer Resistance -0.1
      - 0.6  # HE
      - 0.9  # LASCANON
      - 1.0  # PLASMA
      - 0.7  # STUN; Word Bearer Resistance -0.1
      - 0.7  # MELEE; Word Bearer Resistance -0.1
      - 0.7  # ACID; Word Bearer Resistance -0.1
      - 0.0  # SMOKE
      - 0.2  # IMPACT
      - 1.1  # MELTA Word Bearer Weakness +0.1
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 200 # HUGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 50  # (50 * 100 / 25) = 200. Regenerates from 50 (at 0) to 0 (at 200) / Turn
      ARMOR_ENERGY_SHIELD_DECAY: 25
      INFECTION_RESIST: 100 #blessed by the dark gods
      INTIMIDATION_RESISTANCE: 75 #zealous convictions

  - type: STR_WORDBEARER_SCOUT_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 30
    heatVision: 35
    antiCamouflageAtDark: 5 #minor spotting
    antiCamouflageAtDay: 5
    camouflageAtDark: -5 #minor camo
    camouflageAtDay: -10
    spriteSheet: WORDBEARERscoutbattle.PCK
    spriteInv: WORDBEARERscoutinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_SCOUT_CORPSE
    frontArmor: 80
    sideArmor: 70
    rearArmor: 50
    underArmor: 70
    drawingRoutine: 0
    damageModifier:  # CULTIST ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 0.9  # FLAMES
      - 1.0  # HE
      - 0.8  # LASCANON
      - 0.9  # PLASMA
      - 1.0  # STUN
      - 0.9  # MELEE
      - 1.0  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.0  # MELTA
    loftempsSet: [2]
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      ARMOR_OVERWATCH_TU_RESTORED: 30
      INFECTION_RESIST: 100 #blessed by the dark gods
      INTIMIDATION_RESISTANCE: 50 #zealous convictions
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 1

  - &STR_DAEMON_PORTAL_TEMPLATE
    type: STR_DAEMON_PORTAL_ARMOR
    visibilityAtDay: 1
    visibilityAtDark: 1
    psiVision: 10
    spriteSheet: DAEMONICPORTAL.PCK
    corpseBattle:
      - STR_INVISIBLE_CORPSE
    frontArmor: 0
    sideArmor: 0
    rearArmor: 0
    underArmor: 0
    allowInv: false
    fearImmune: true
    zombiImmune: true
    painImmune: true
    bleedImmune: true
    allowsMoving: false
    movementType: 1 #can float
    size: 1
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.5  # AP
      - 0.5  # FLAMES
      - 0.5  # HE
      - 0.5  # LASCANON
      - 0.5  # PLASMA
      - 0.0  # STUN
      - 0.5  # MELEE
      - 0.0  # ACID; it's not alive and can't suffer chemical burns
      - 0.0  # SMOKE; it's not alive and can't suffer chemical burns
      - 0.0  # IMPACT
      - 0.5  # MELTA
      - 0.0  # GRAV; it has no mass to maniplate
    constantAnimation: true
    loftempsSet: [1]
    drawingRoutine: 4
    scripts:
      selectUnitSprite: |
        # this script will always run move animation of unit.
        var int temp;
        var int walking;
        unit.isWalking walking;
        if eq walking 0;
          unit.getId temp;
          offsetmod temp 11 0 8; # desync animation of different units
          add temp anim_frame;
          wavegen_saw temp 8 8 7;
          mul sprite_offset 8;
          add sprite_offset 8;
          add sprite_offset temp;
          set sprite_index sprite_offset;
        else;
          add sprite_index sprite_offset;
        end;
        return sprite_index;
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_PSYKER: 1
      UNIT_TYPE_DAEMONIC: 1
      IS_DAEMONIC_PORTAL: 3
      INFECTION_RESIST: 100 #it's a hell portal
      INTIMIDATION_RESISTANCE: 100 #it's a hell portal
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 100  # (100 * 100 / 25) = 400. Regenerates from 100 (at 0) to 0 (at 500) / Turn
      ARMOR_ENERGY_SHIELD_DECAY: 25

  - type: STR_DAEMON_PORTAL_ARMOR_LESSER
    refNode: *STR_DAEMON_PORTAL_TEMPLATE
    tags:
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_PSYKER: 1
      UNIT_TYPE_DAEMONIC: 1
      IS_DAEMONIC_PORTAL: 2
      INFECTION_RESIST: 100 #it's a hell portal
      INTIMIDATION_RESISTANCE: 100 #it's a hell portal
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 75  # (100 * 100 / 25) = 300. Regenerates from 100 (at 0) to 0 (at 500) / Turn
      ARMOR_ENERGY_SHIELD_DECAY: 25

  - type: STR_DAEMON_PORTAL_ARMOR_MINOR
    refNode: *STR_DAEMON_PORTAL_TEMPLATE
    tags:
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_PSYKER: 1
      UNIT_TYPE_DAEMONIC: 1
      IS_DAEMONIC_PORTAL: 1
      INFECTION_RESIST: 100 #it's a hell portal
      INTIMIDATION_RESISTANCE: 100 #it's a hell portal
      ARMOR_ENERGY_SHIELD_HP_PER_TURN: 50  # (100 * 100 / 25) = 200. Regenerates from 100 (at 0) to 0 (at 500) / Turn
      ARMOR_ENERGY_SHIELD_DECAY: 25

