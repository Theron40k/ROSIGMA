    damageModifier:  # TERMINATOR ARMOR
      - 1.0  # none
      - 0.7  # AP;
      - 0.1  # FLAMES; Word Bearer Resistance -0.1
      - 0.6  # HE
      - 0.8  # LASCANON
      - 0.9  # PLASMA
      - 0.7  # STUN; Word Bearer Resistance -0.1
      - 0.7  # MELEE; Word Bearer Resistance -0.1
      - 0.2  # ACID; Word Bearer Resistance -0.1 + Daemonic resistance
      - 0.0  # SMOKE
      - 0.2  # IMPACT
      - 1.1  # MELTA Word Bearer Weakness +0.1
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    recovery: #loses shield but regenerates rapidly
      health:
        healthCurrent: 0.5
        fatalWounds: 5
    tags:
      UNIT_SIZE: 200 # HUGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      ARMOR_OVERWATCH_TU_RESTORED: 100
      INFECTION_RESIST: 100 #blessed by the dark gods
      INTIMIDATION_RESISTANCE: 100 #zealous convictions
      DODGE_CHANCE: 15
      ARMOR_MAX_SUCCESSFUL_DODGES: 3

  - type: STR_WORDBEARER_DIABOLIST_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 25
    heatVision: 20
    spriteSheet: WORDBEARERdiabolistbattle.PCK
    spriteInv: WORDBEARERdiabolistinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_DIABOLIST_CORPSE
    frontArmor: 120
    sideArmor: 110
    rearArmor: 80
    underArmor: 120
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.9  # AP
      - 0.6  # FLAMES
      - 0.7  # HE
      - 0.8  # LASCANON
      - 1.1  # PLASMA
      - 1.1  # STUN
      - 1.1  # MELEE Weakness
      - 1.0  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      INFECTION_RESIST: 100
      INTIMIDATION_RESISTANCE: 50
      DODGE_CHANCE: 5
      ARMOR_MAX_SUCCESSFUL_DODGES: 1

  - type: STR_WORDBEARER_DIABOLISTELITE_ARMOR
    visibilityAtDay: 40
    visibilityAtDark: 30 #artificer armor
    heatVision: 30 #artificer armor
    antiCamouflageAtDay: 5  #Keen senses
    antiCamouflageAtDark: 5  #Keen senses
    spriteSheet: WORDBEARERarchdiabolistbattle.PCK
    spriteInv: WORDBEARERarchdiabolistinvent.SPK
    corpseBattle:
      - STR_WORDBEARER_DIABOLISTELITE_CORPSE
    frontArmor: 130
    sideArmor: 120
    rearArmor: 90
    underArmor: 130
    damageModifier:  # CHAOS ARMOR WEAKER
      - 1.0  # none
      - 0.8  # AP
      - 0.5  # FLAMES
      - 0.6  # HE
      - 0.8  # LASCANON
      - 1.0  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 0.9  # ACID
      - 0.0  # SMOKE
      - 0.2  # IMPACT
      - 1.1  # MELTA
    loftempsSet: [4]
    allowsRunning: false  # NPC limits for BAI
    tags:
      UNIT_SIZE: 150 # LARGE
      UNIT_TYPE_CHAOS: 1
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_DAEMONIC: 1
      UNIT_TYPE_PSYKER: 1
      INFECTION_RESIST: 100
      INTIMIDATION_RESISTANCE: 50
      DODGE_CHANCE: 5
      ARMOR_MAX_SUCCESSFUL_DODGES: 1

    scripts:
      selectUnitSprite: |
        # https://openxcom.org/forum/index.php/topic, 4322.msg75634.html# msg75634
        # and power pack for veterans/scions
        var int temp;
        var int walking;
        var int floating;
        var int isFemale;

        var int numOfFrames;

        unit.isWalking walking;
        unit.isFloating floating;
        unit.getGender isFemale;

        set numOfFrames 6;


        unit.getId temp;

        add temp anim_frame;
        mod temp numOfFrames;
        mul temp 8;


        if eq blit_part blit_torso; # if torso to be drawn
            if eq floating 0;

              set sprite_index 288; # position after female and flying legs (8+8 + some extra offset so it's multiple of 16)
              add sprite_index temp;
              if neq 0 isFemale;
                # using isFemale differently for now;
                set isFemale 8;
                mul isFemale numOfFrames;
                add sprite_index isFemale;
              end;
            end;
        end;

        add sprite_index sprite_offset; # add direction

        return sprite_index;