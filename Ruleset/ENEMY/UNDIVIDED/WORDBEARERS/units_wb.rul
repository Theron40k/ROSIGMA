  # Word Bearers

  - type: CHAOS_WORDBEARER_DARK_APOSTLE_SET
    weapons: [STR_DARK_SERMON, STR_WORDBEARER_CHAOS_CROZIUS]

  # Word Bearer Possessed
  - type: BASIC_WORDBEARER_POSSESSED_INTIMIDATE_LOADOUT
