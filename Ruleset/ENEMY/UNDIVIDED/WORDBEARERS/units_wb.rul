  # Terminator Loadouts
  - type: TERMINATOR_COMBIBOLTER
    weapons: [STR_CHB, STR_HB_CLIP_MC, STR_HB_CLIP, STR_CHAOS_CLAWS, STR_MGRENADE, STR_MGRENADE]
  - type: TERMINATOR_HEAVYPLASMA
