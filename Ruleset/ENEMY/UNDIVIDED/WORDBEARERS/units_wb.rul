extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

weaponSets:  # these can be re-used for any unit

  # Undivided Chaos Space Marines
  - type: BASIC_CSM_CHAOS_BOLTER_LOADOUT
    weapons: [STR_BOLTERC, STR_RIFLE_CLIP, STR_RIFLE_CLIP, STR_KRAK_GRENADE, STR_ALIEN_GRENADE, STR_GRENADE]
  - type: BASIC_CSM_LIGHT_CHAOS_BOLTER_LOADOUT
    weapons: [STR_LIGHT_BOLTER_CHAOS, STR_LIGHT_BOLTER_AMMO, STR_LIGHT_BOLTER_AMMO, STR_GRENADE, STR_GRENADE]
  - type: BASIC_CSM_LIGHT_CHAOS_BOLTER_AP_LOADOUT
    weapons: [STR_LIGHT_BOLTER_CHAOS, STR_LIGHT_BOLTER_AMMO_PEN, STR_LIGHT_BOLTER_AMMO_PEN, STR_KRAK_GRENADE, STR_ALIEN_GRENADE]
  - type: BASIC_CSM_AP_CHAOS_BOLTER_LOADOUT
