  - type: BASIC_CSM_PLASMA_RIFLE_LOADOUT
    weapons: [STR_PLASMA_RIFLE, STR_PLASMA_RIFLE_CLIP, STR_PLASMA_RIFLE_CLIP, STR_PLASMA_RIFLE_CLIP, STR_KRAK_GRENADE, STR_MGRENADE, STR_ALIEN_GRENADE]
  - type: BASIC_CSM_CHAOS_BOLTPISTOL_AXE_LOADOUT
    weapons: [STR_AXE, STR_BOLTPISTOL_CHAOS, STR_PISTOL_CLIP_AP, STR_PISTOL_CLIP_AP, STR_PISTOL_CLIP_AP, STR_PISTOL_CLIP_AP, STR_KRAK_GRENADE, STR_ALIEN_GRENADE, STR_ALIEN_GRENADE]
  - type: BASIC_CSM_CHAOS_PLASMAPISTOL_POWERSWORD_LOADOUT
