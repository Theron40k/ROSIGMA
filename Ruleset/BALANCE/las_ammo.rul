extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

items:
  # from rebalance mod
  - &LASGUN_DAMAGE_ALTER
    type: STR_LASPISTOL_CLIP
    damageType: 1  # AP instead of LAS
    damageAlter:
      ToArmorPre: 0.2
      ToHealth: 1.0
      ToArmor: 0.1  # 40k 0.0  # hardly makes a difference
      ToStun: 0.3  # painful las burns
      ToWound: 0.05  # cauterizes, but there's still explosive thermal expansion of tissues; melta level wounding
      RandomWound: false
    clipSize: 30
    # lasgun aesthetics
    hitSound: 3986
    hitAnimation: 2220
    bulletSprite: {mod: 40k, index: 22}
    fireSound: 3981
    vaporColorSurface: 4  # red laser
    vaporDensitySurface: 2
    vaporProbabilitySurface: 100
    bulletSpeed: 10
    explosionSpeed: 3
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - type: STR_LASPISTOL_CLIP_HOTSHOT
    refNode: *LASGUN_DAMAGE_ALTER
    fireSound: 3983
    listOrder: 10850  # group with laspistol clips
    damageAlter:
      ArmorEffectiveness: 0.75
    clipSize: 10  # -10, hotshot power drain
    vaporDensitySurface: 2
    tags:
      ITEM_AMMO_COLOR: 2
      ITEM_AMMO_SHADE: -3
      ITEM_AMMO_REPEATED_ACCURACY_FALLOFF_MULTIPLIER: 5

  - type: STR_LASGUN_CLIP_HOTSHOT_CHAOS
    refNode: *LASGUN_DAMAGE_ALTER
    fireSound: 3983
    damageAlter:
      ToArmorPre: 0.3
      ArmorEffectiveness: 0.75
      ToArmor: 0.0
      ToStun: 0.0
    clipSize: 10
    vaporDensitySurface: 2
    tags:
      ITEM_AMMO_REPEATED_ACCURACY_FALLOFF_MULTIPLIER: 0

  - type: STR_LASGUN_CLIP
    refNode: *LASGUN_DAMAGE_ALTER
    clipSize: 60

  # - type: STR_LASGUN_CLIPB

  - type: STR_LASGUN_CLIP_HOTSHOT
    refNode: *LASGUN_DAMAGE_ALTER
    fireSound: 3983
    damageAlter:
      ArmorEffectiveness: 0.75
    clipSize: 20  # -10 hotshot drains more power.
    vaporDensitySurface: 2
    tags:
      ITEM_AMMO_REPEATED_ACCURACY_FALLOFF_MULTIPLIER: 5  #

  - type: STR_LASCANNON_CLIP_MALTHUS  # LASCANON MALTHUS POWER PACK               2018
    power: 140
    damageType: 4
    damageAlter:  # DA LAS MELTA
      RandomType: 6
      ToArmorPre: 0.5
      ToHealth: 0.8
      ToArmor: 0.2
      ToStun: 0.0
    clipSize: 8
    powerRangeThreshold: 16
    powerRangeReduction: 5  # lowers power by 5 by each tile beyond 10, at range 20 it has lost 50 power.
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3984
    hitAnimation: 2230
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 4  # red laser
    vaporDensitySurface: 4
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - &LASCANNON_MAGAZINE_TEMPLATE
    type: STR_LASCAN_CLIP  # LASCANON CLIP
    power: 220
    damageAlter:  # DA LAS
      RandomType: 6  # gaussian
      ToArmorPre: 0.4
      ToHealth: 1.0
      ToArmor: 0.1
      ToStun: 0.3
    clipSize: 5
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3984
    hitAnimation: 2230
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 4  # red laser
    vaporDensitySurface: 6  # thick laser
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - type: STR_LASCANNON_CLIP_SMALL
    refNode: *LASCANNON_MAGAZINE_TEMPLATE
    clipSize: 2  # it's 1/3rd the size of the large power pack and has a much easier to fit profile; needed downgrade

  - &PORTABLE_MULTILASER_BATTERY_TEMPLATE
    type: STR_PORTABLE_MULTILASER_BATTERY  # MULTILAS POWER PACK
    categories: [STR_CAT_LASGUN]
    size: 0.2
    requiresBuy:
      - STR_MULTILAS_HANDHELD_RESEARCH
    costBuy: 10000
    costSell: 5000
    invWidth: 3
    invHeight: 2
    weight: 15
    battleType: 2
    bigSprite: 1008  # battery pack 3x2 wide
    floorSprite: {mod: 40k, index: 1021}
    handSprite: {mod: 40k, index: 1168}
    power: 50
    damageType: 1  # AP instead of LAS
    damageAlter:
      ToArmorPre: 0.25 # In between Multilas Turret and Multilas Sentinel stats
      ToHealth: 1.0
      ToArmor: 0.1  # 40k 0.0
      ToStun: 0.3  # painful las burns
      ToWound: 0.05  # cauterizes, but there's still explosive thermal expansion of tissues; melta level wounding
    clipSize: 180 # 15 Multilas Auto Bursts before needing to reload; 3 times cap of Hotshot
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3981
    hitAnimation: 2220
    bulletSprite: {mod: 40k, index: 22}
    bulletSpeed: 50
    explosionSpeed: 3 # makes it shoot faster/take less time per shot
    vaporColorSurface: 4  # red laser
    vaporDensitySurface: 2
    vaporProbabilitySurface: 100
    listOrder: 10762
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - type: STR_PORTABLE_MULTILASER_BATTERY_HOTSHOT  # MULTILAS HOTSHOT POWER PACK
    refNode: *PORTABLE_MULTILASER_BATTERY_TEMPLATE
    requiresBuy:
      - STR_MULTILAS_HANDHELD_RESEARCH
      - STR_LASGUN_HOTSHOT # Hotshot ammo
    costBuy: 50000 # Expensive
    costSell: 10000
    bigSprite: 1110  # Hotshot battery pack 3x2 wide
    power: 65
    damageType: 1  # AP instead of LAS
    damageAlter:
      ArmorEffectiveness: 0.75 # Hotshot
      ToArmorPre: 0.3 # +.05 from Hotshot ammo
      ToHealth: 1.0
      ToArmor: 0.1  # 40k 0.0
      ToStun: 0.3  # painful las burns
      ToWound: 0.05  # cauterizes, but there's still explosive thermal expansion of tissues; melta level wounding
    clipSize: 60 # 5 Multilas Auto Bursts before needing to reload
    # lasgun aesthetics
    fireSound: 3983
    bulletSpeed: 50
    vaporDensitySurface: 3 # hotshot, but not lascannon thicc
    listOrder: 10763
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;
    tags:
      ITEM_AMMO_REPEATED_ACCURACY_FALLOFF_MULTIPLIER: 3  # Hotshot strains the barrel, decreasing accuracy