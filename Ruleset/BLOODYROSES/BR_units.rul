extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

units:

  - type: STR_ARVUSSMOKER_UNIT
    moraleLossWhenKilled: 25
    canBeMindControlled: false
    energyRecovery: 10
    standHeight: 16
    kneelHeight: 16
    deathSound: {mod: 40k, index: 23}
    liveAlien: ""
    stats:
      health: 50
      tu: 20
      stamina: 20
      reactions: 20
      bravery: 110
      firing: 100
      throwing: 0
      strength: 100
      psiStrength: 250
      psiSkill: 0
      melee: 0
      mana: 100
    armor: ARVUSSMOKER_ARMOR
    builtInWeaponSets:
      - - STR_ARVUSSMOKER
        - STR_ARVUSSMOKER_AMMO
      - - STR_ARVUSSMOKER
        - STR_ARVUSSMOKER_AMMO
      - - STR_ARVUSSMOKER
        - STR_ARVUSSMOKER_AMMO

armors:

  - type: ARVUSSMOKER_ARMOR
    visibilityAtDay: 1
    visibilityAtDark: 1
    spriteSheet: INVISIBLE_DR1.PCK  # not seen it's a map block content that look like it
    allowInv: false
    zombiImmune: true
    bleedImmune: true
    fearImmune: true
    painImmune: true
    allowsMoving: false
    spriteInv: RAZOR
    corpseGeo: STR_DREAD_CORPSE
    corpseBattle:
      - O_CORPSE
    frontArmor: 130
    sideArmor: 130
    rearArmor: 100
    underArmor: 130
    damageModifier:  # VEHICLE ARMOR LARGE
      - 1.0  # none
      - 1.0  # AP
      - 0.4  # FLAMES
      - 1.0  # HE
      - 1.4  # LASCANON
      - 1.0  # PLASMA
      - 0.0  # STUN
      - 0.8  # MELEE
      - 1.0  # ACID
      - 0.0  # SMOKE
      - 1.0  # IMPACT
      - 1.2  # MELTA
    loftempsSet: [3]
    drawingRoutine: 1
    selectUnitMale: [{mod: 40k, index: 575}, {mod: 40k, index: 576}]
    selectUnitFemale: [{mod: 40k, index: 575}, {mod: 40k, index: 576}]
    selectWeaponMale: [{mod: 40k, index: 571}, {mod: 40k, index: 572}, {mod: 40k, index: 573}, {mod: 40k, index: 574}]
    selectWeaponFemale: [{mod: 40k, index: 571}, {mod: 40k, index: 572}, {mod: 40k, index: 573}, {mod: 40k, index: 574}]
    annoyedMale: [{mod: 40k, index: 577}]
    annoyedFemale: [{mod: 40k, index: 577}]
    tags:
      INFECTION_RESIST: 100  # infection immune
      INTIMIDATION_RESISTANCE: 100  # intimidation immune
      UNIT_TYPE_MECHANICAL: 1
      UNIT_TYPE_CHAOS: 1
      UNIT_SIZE: 200 # HUGE