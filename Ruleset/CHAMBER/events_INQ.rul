# Design notes:
# On the Events which can Reoccur Monthly (off of Secure Support Event Scripts, for example),
# they will all occur at the same time. This is a thought to convenience,
# since a player could have like 5 of these queue'd up each month, and it's nicer
# to click through them all at once.
# player

events:
  - name: STR_STANDARD_INQ_GAME_START
    adhocMissionScriptTags: ["gameStartHard"]
    description: STR_STANDARD_INQ_GAME_START_DESC
    background: StormtroopersBG.SCR
    interruptResearch: STR_NOT_NORMAL_INQUISITION
    researchList: [STR_CHAMBER_NOT_ARBITES]
    spawnedCraftType: STR_XIPHON_GK
    timer: 2880
    # everyMultiSoldierList:
    #   STR_INQ_STORMTROOPER: 4  # give extra stormtroops in this default case
    # everyMultiItemList:
    #   STR_CRATED_ARVUS_GK: 1

  - name: STR_REINFORCEMENTS_GK
    adhocMissionScriptTags: ["gameStartHard"]
    description: STR_REINFORCEMENTS_GK_DESCRIPTION
    researchList: [STR_CHAMBER_NOT_ARBITES]
    spawnedCraftType: STR_XIPHON_GK
    everyMultiItemList:
      STR_CRATED_ARVUS_GK: 1
      STR_HB_CLIP: 50
    spawnedPersons: 4
    spawnedPersonType: STR_GK_LV1

  - name: STR_REINFORCEMENTS_GK_1
    spawnedPersons: 4  # was 2

  - name: STR_REINFORCEMENTS_GK_2
    spawnedPersons: 3  # was 1

  - name: STR_REINFORCEMENTS_GK_3
    spawnedPersons: 3  # was 1

  # Event to explain that Armors and Psykers are available
  - name: STR_INQ_PSYCHIC_SANCTION_RESEARCH_EVENT
    description: STR_INQ_PSYCHIC_SANCTION_RESEARCH_EVENT_DESCRIPTION
    background: PsykersBG.SCR
    timer: 0

  - name: STR_INQ_REQUISITION_AGENTS_EVENT
    description: STR_INQ_REQUISITION_AGENTS_EVENT_DESCRIPTION
    background: EcclessiarchyBG4.SCR
    timer: 1440  # between 1-3 days
    everyMultiItemList:
      STR_LASER_RIFLEG: 2
      STR_LASGUN_CLIP: 8
      STR_AUTOGUN_ADEPTAS_SCOPED: 3
      STR_AUTOGUN_CLIP: 12
      STR_EVISCERATOR: 1
      STR_KNIF: 2
    everyMultiSoldierList:
      STR_GUARD_VETERAN: 2
      STR_GUARDPD: 2
      STR_PSYKER: 1
      STR_GUARD_PRIEST: 1
      STR_ADEPTAS_DCAssassin: 1
      STR_IMPERIAL_ASSASSINFEM: 1

  # Secure Support (Agents): Event to explain the mechanic
  - name: STR_INQ_SECURE_SUPPORT_IMPERIAL_AGENTS_EVENT
    description: STR_INQ_SECURE_SUPPORT_IMPERIAL_AGENTS_EVENT_DESCRIPTION  # "Local Inquisitorial Agents have arrived to assist you. These are experienced veterans with local connections and knowledge of subversive elements."
    background: InquisitionLedgerBG.SCR
    timer: 0

