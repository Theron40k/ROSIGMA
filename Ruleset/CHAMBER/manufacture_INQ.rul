manufacture:
  - name: STR_INQ_STORMTROOPER_REQUISITION
    category: STR_ADVANCEMENT
    requires:
      - STR_INQ_STORMTROOPER_REQUISITION
    space: 0
    time: 500
    cost: 200000
    requiredItems:
      STR_KILLPOINT_TOKEN: 100
    spawnedPersonType: STR_INQ_STORMTROOPER
    producedItems:
      STR_KILLPOINT_TOKEN: 1
    spawnedSoldier:
      previousTransformations:                    # Mark all with RetinueInduct to enable Chamber Transforms.
        STR_INQ_TRANSFORM_RETINUE_INDUCTION: 1  # Note this method does not apply stats from RetinueInduct.

  - name: STR_IMPERIAL_INQUISITOR_REQUISITION
