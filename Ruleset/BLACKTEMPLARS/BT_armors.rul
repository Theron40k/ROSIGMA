extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

armors:

  - type: STR_BTSCOUTARMOR_PLAYER  # BT NOVICE
    isPilotArmor: true
    customArmorPreviewIndex: 960
    visibilityAtDay: 40
    visibilityAtDark: 40
    antiCamouflageAtDay: 8
    antiCamouflageAtDark: 8
    camouflageAtDay: -7  # you need to be 7 tiles closer than max vision range to see this unit in the light
    camouflageAtDark: -5  # you need to be 5 tiles closer than max vision range (at night!) to see this unit in the dark
    heatVision: 25
    spriteSheet: BLACKTEMPLARSCOUTbattle.PCK
    drawingRoutine: 0
    storeItem: STR_BTSCOUTARMOR_PLAYER
    corpseBattle:
      - STR_BTSCOUTPLAYER_CORPSE
    corpseGeo: STR_FALLEN_CORPSE
    stats:
      tu: 30
      stamina: 0
      firing: 0
      health: 0
      bravery: 0  # always multiples of 10
      reactions: 30
      throwing: 10
      strength: 0
      psiStrength: 0
      psiSkill: 0
      melee: 0
    frontArmor: 80
    sideArmor: 60
    rearArmor: 40
    underArmor: 60
    damageModifier:  # SCOUT ARMOR
      - 1.0  # none
      - 1.0  # AP
      - 1.0  # FLAMES
      - 1.0  # HE
      - 1.0  # LASCANON
      - 1.0  # PLASMA
      - 1.0  # STUN
      - 1.0  # MELEE
      - 1.0  # ACID
      - 0.5  # SMOKE
      - 0.2  # IMPACT
      - 1.0  # MELTA
    units:
      - STR_BTMARINE_PLAYER
      - STR_BTHONORED_PLAYER
    builtInWeapons:
      - STR_PISTOL_BT
      - STR_PISTOL_CLIP
      - STR_CHAINSWORD_BT
    loftempsSet: [2]
    tags:
      UNIT_TYPE_IMPERIUM: 1
      UNIT_TYPE_LIVING: 1
      UNIT_SIZE: 125 # LARGE but not as large as power armor
      DODGE_CHANCE: 10
      ARMOR_MAX_SUCCESSFUL_DODGES: 1
      INTIMIDATION_RESISTANCE: 50 #lwoer than tac marine

  - &STR_BTMARINE_BASEARMOR
