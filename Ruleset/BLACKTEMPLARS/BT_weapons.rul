  - type: STR_ADEPTAS_ZWEIHANDER_BT  # BT ZWEIHANDER
    recover: false # weapon attached to armor cant add this in recovery
    fixedWeapon: true
    fixedWeaponShow: true
    categories: [STR_CAT_MELEE, STR_CAT_ADEPTAS]
    size: 0.3
    weight: 35
    bigSprite: 4016
    floorSprite: 4016
    handSprite: 4507
    meleeAnimation: {mod: 40k, index: 4}
    meleeSound: {mod: 40k, index: 753}  # 753 Powerswrod miss
    meleeHitSound: {mod: 40k, index: 754}  # 744 Powerswrod hit
    scripts:
      selectItemSprite: |

        var int temp;
        var int numOfFrames;
        set numOfFrames 4;

        if or eq blit_part blit_item_lefthand eq blit_part blit_item_righthand;

            add temp anim_frame;
            mod temp numOfFrames;
            mul temp 8;
            add sprite_index temp;
        end;

        add sprite_index sprite_offset; # add direction
        return sprite_index;
    power: 120  # melee
    damageBonus:
      strength: 0.6
      melee: 0.2
    meleeMultiplier:
      melee: 0.8
      strength: 0.2
    damageAlter:     # DA POWER
      ArmorEffectiveness: 0.7
      ToArmorPre: 0.4
      ToHealth: 0.9
      RandomType: 7  # TFTD [50% - 200%]
      IgnoreSelfDestruct: false
    damageType: 5
    accuracyMelee: 80
    twoHanded: false  # using trick to block both hands
    flatRate: true
    costMelee:
      time: 20
      energy: 8  # very heavy melee weapon
    flatMelee:
      time: true
      energy: true
    clipSize: -1
    battleType: 3
    invWidth: 2
    invHeight: 3
    attraction: 6
    armor: 200
