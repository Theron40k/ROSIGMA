      FireThreshold: 0
      ToHealth: 0.75
      ToMorale: 1.0
      ToWound: 0.0
      RandomWound: false
      RandomType: 6
      IgnoreSelfDestruct: false
    experienceTrainingMode: 13
    listOrder: 12400
    tags:
      ITEM_STRENGTH_REQUIREMENT: 20
      REACTION_MULTIPLIER: 200
      DAMAGE_BONUS_PERCENT_DAEMONIC: 150 #1.5x damage vs Daemons
    scripts:
      selectItemSprite: |

        var int temp;
        var int numOfFrames;
        set numOfFrames 4;

        if or eq blit_part blit_item_lefthand eq blit_part blit_item_righthand;

            add temp anim_frame;
            mod temp numOfFrames;
            mul temp 8;
            add sprite_index temp;
        end;

        add sprite_index sprite_offset; # add direction
        return sprite_index;