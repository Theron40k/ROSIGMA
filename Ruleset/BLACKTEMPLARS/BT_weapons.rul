  - type: STR_ADEPTAS_ZWEIHANDERTRICK_BT  # BT ZWEIHANDER
    ufopediaType: STR_ADEPTAS_ZWEIHANDER_BT
    recover: false # weapon attached to armor cant add this in recovery
    fixedWeapon: true
    fixedWeaponShow: true
    categories: [STR_CAT_MELEE, STR_CAT_ADEPTAS]
    size: 0.3
    weight: 35
    meleeAnimation: {mod: 40k, index: 4}
    meleeSound: {mod: 40k, index: 753}  # 753 Powersword miss
    meleeHitSound: {mod: 40k, index: 754}  # 744 Powersword hit
    scripts:
      selectItemSprite: |

        var int temp;
        var int numOfFrames;
        set numOfFrames 4;

        if or eq blit_part blit_item_lefthand eq blit_part blit_item_righthand;

            add temp anim_frame;
            mod temp numOfFrames;
            mul temp 8;
            add sprite_index temp;
        end;

        add sprite_index sprite_offset; # add direction
        return sprite_index;
    power: 120  # melee
    damageBonus:
      strength: 0.6
      melee: 0.2
    meleeMultiplier:
      melee: 0.8
      strength: 0.2
