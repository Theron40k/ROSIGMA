items:

  - type: STR_BTSPONSON_HB
    dropoff: 4
    weight: 0
    size: 0
    bigSprite: {mod: 40k, index: 640}
    bulletSprite: 6
    fireSound: {mod: 40k, index: 707}
    explosionSpeed: 5
    bulletSpeed: 50
    hitSound: {mod: 40k, index: 708}
    hitAnimation: {mod: 40k, index: 26}
    autoRange: 15
    accuracyAuto: 50
    costAuto:
      time: 1
      energy: 10
      mana: 10
    flatUse:
      time: true
      energy: true
      mana: true
    battleType: 1
    damageType: 1
    power: 100
    damageAlter:  # DA BOLTER
      ToArmorPre: 0.15
      ArmorEffectiveness: 0.85
      ToArmor: 0.15
      ToHealth: 1.1
      ToStun: 0.5
      ToEnergy: 0.4
      ToWound: 0.3
      RandomWound: false
    autoShots: 12
    sprayWaypoints: 2
    invWidth: 2
    invHeight: 3
    clipSize: -1
    twoHanded: false
    fixedWeapon: true
    recover: false
    tags:
      TURRET_RELOAD_TURNS: 2

