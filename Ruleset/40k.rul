extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul

weaponSets:  # these can be re-used for any unit

  # Traitor
  - type: CHAOS_MORTAR_HEAVY_SET
    weapons: [STR_MORTAR_PORTABLE_CHAOS, STR_MORTAR_AMMO_HE, STR_MORTAR_AMMO_HE, STR_MORTAR_AMMO_FRAG, STR_MORTAR_AMMO_FRAG, STR_MORTAR_AMMO_PHOSPHOR]
  - type: CHAOS_VOLLEYGUN_SET
    weapons: [STR_CHAOS_VOLLEYGUN, STR_ALIEN_GRENADE, STR_ALIEN_GRENADE]
  - type: CHAOS_COMBIBOLTER_SIMPLE_SET
    weapons: [STR_CHB, STR_HB_CLIP_MC, STR_HB_CLIP, STR_MGRENADE]
  - type: CHAOS_ASSAULTCANNON_SIMPLE_SET
    weapons: [STR_CASSC, STR_AUTOCANNON_BOX_AMMO, STR_AUTOCANNON_BOX_AMMO, STR_MGRENADE]

  # Chaos Undivided Ritualist weaponSets
  - type: CHAOS_POWER_DAGGER_SET
    weapons: [STR_CPOWER_DAGGER]
  - type: CHAOS_POWER_DAGGER_AND_STUB_GUN_SET
    weapons: [STR_CPOWER_DAGGER, STR_STUB_GUN_CHAOS, STR_STUB_GUN_AMMO]
  - type: CHAOS_POWER_DAGGER_AND_LASPISTOL_SET
    weapons: [STR_CPOWER_DAGGER, STR_LASER_PISTOLC, STR_LASPISTOL_CLIP]
  - type: CHAOS_POWER_DAGGER_AND_LASPISTOL_WITH_BLIGHT_GRENADE_SET
    weapons: [STR_CPOWER_DAGGER, STR_LASER_PISTOLC, STR_LASPISTOL_CLIP, STR_ALIEN_GRENADE]
  # chaos sniper and sharpshooter weaponSets:
  - type: CHAOS_SNIPER_UNDIVIDED_COMMANDER_SET  # sniper set with AP ammo and summoning grenades
    weapons: [STR_SNIPER_CHAOS, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_BLOODLETTERSPAWNER_GRENADE, STR_DAEMONETTESPAWNER_GRENADE, STR_FLAMERSPAWNER_GRENADE, STR_PLAGUEBEARERSPAWNER_GRENADE]
  - type: CHAOS_SNIPER_AP_AND_ALIEN_GRENADE_SET  # sniper set with AP ammo and blight grenade
    weapons: [STR_SNIPER_CHAOS, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_ALIEN_GRENADE]
  - type: CHAOS_SNIPER_AP_AND_MELTA_GRENADE_SET  # sniper set with AP ammo and melta grenade
    weapons: [STR_SNIPER_CHAOS, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_MGRENADE]
  - type: CHAOS_SNIPER_AP_AND_KRAKGRENADE_SET  # sniper set with AP ammo and krak grenade
    weapons: [STR_SNIPER_CHAOS, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_KRAK_GRENADE]
  - type: CHAOS_SNIPER_AP_SET  # sniper set with AP ammo
    weapons: [STR_SNIPER_CHAOS, STR_HC_AP_AMMO, STR_HC_AP_AMMO, STR_HC_AP_AMMO]
  - type: CHAOS_SNIPER_HE_WITH_MELTA_GRENADE_SET  # sniper set with a melta grenade
    weapons: [STR_SNIPER_CHAOS, STR_HC_HE_AMMO, STR_HC_HE_AMMO, STR_HC_HE_AMMO, STR_HC_HE_AMMO, STR_MGRENADE]
  - type: CHAOS_SNIPER_HE_SET  # sniper set
    weapons: [STR_SNIPER_CHAOS, STR_HC_HE_AMMO, STR_HC_HE_AMMO, STR_HC_HE_AMMO]
  - type: CHAOS_STUB_RIFLE_WOUND_SET  # sharpshooter set with wounding ammo for nightlords
    weapons: [STR_STUB_RIFLE_CHAOS, STR_STUB_GUN_AMMO_WOUND, STR_STUB_GUN_AMMO_WOUND]
  - type: CHAOS_STUB_RIFLE_WOUND_AND_MAKESHIFT_GRENADE_SET  # sharpshooter set with wounding ammo and makeshift grenade
    weapons: [STR_STUB_RIFLE_CHAOS, STR_STUB_GUN_AMMO_WOUND, STR_STUB_GUN_AMMO_WOUND, STR_MAKESHIFT_GRENADE]
  - type: CHAOS_STUB_RIFLE_HP_AND_SCARE_GRENADE_SET  # sharpshooter set with 2xHP ammo and scare grenade
    weapons: [STR_STUB_RIFLE_CHAOS, STR_STUB_GUN_AMMO_HP, STR_STUB_GUN_AMMO_HP, STR_SCARE_GRENADE]
  - type: CHAOS_STUB_RIFLE_AP_AND_SCARE_GRENADE_SET  # sharpshooter set with 2xAP ammo and scare grenade
    weapons: [STR_STUB_RIFLE_CHAOS, STR_STUB_GUN_AMMO_AP, STR_STUB_GUN_AMMO_AP, STR_SCARE_GRENADE]
  - type: CHAOS_STUB_RIFLE_AP_AND_SMOKEMAKESHIFT_GRENADE_SET  # sharpshooter set with 2xAP ammo, smoke and makeshift grenades
