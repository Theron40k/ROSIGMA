  ## IG Heavy Weapons

  - type: STR_BEASTGUARD_HEAVY_ARMOR
    requiresBuy:
      - STR_BEASTMEN_GUARDSMEN
      - STR_CARAPACE_ARMOR_IG
      - STR_UFO_CONSTRUCTION  # ceramite
    size: 0.3
    # costBuy: 100000  # custom sized, could make it a manufacturing project to require adamantium
    costSell: 25000
    transferTime: 10
    listOrder: 6662

  - type: STR_BEASTGUARD_HEAVY_ARMOR_SLAB
    requiresBuy:
      - STR_BEASTMEN_GUARDSMEN
      - STR_CARAPACE_ARMOR_IG
      - STR_UFO_CONSTRUCTION  # ceramite
    size: 0.3
    # costBuy: 100000  # custom sized, could make it a manufacturing project to require adamantium
