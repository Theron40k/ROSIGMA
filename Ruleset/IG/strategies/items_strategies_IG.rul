  - type: STR_FELINID_JUMP_ARMOR
    size: 0.2
    # costBuy: 100000  # custom
    costSell: 12500
    transferTime: 10
    listOrder: 6661

  - type: STR_BEASTGUARD_CARAPACE_ARMOR
