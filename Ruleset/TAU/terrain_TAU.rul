### Imperial/Redemptionist themed
  - name: IMP_MUNDAINDUSTRIALURBANDIO
    mapDataSets:
      - BLANKS
      - MUNDAPORTROADS
      - MUNDAPORTURBITS
      - MUNDAROADS
      - MUNDAURBITS
      - MUNDAICHURCH_REDEMPTIONIST
    civilianTypes:
      - MALE_CIVILIAN
      - FEMALE_CIVILIAN
    script: MUNDAINDUSTRIALURBANDIO
    mapBlocks:
      - name: MUNDAINDUSTRIALURBANCULT00  # 2x2 barrel+crane warehouse
        width: 20
        length: 20
      - name: MUNDAINDUSTRIALURBANCULT01  # 2x2 garage
        width: 20
        length: 20
      - name: MUNDAINDUSTRIALURBANCULT02  # 2x2 fenced warehouse
