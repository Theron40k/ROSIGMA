          STR_REQUISITION_BOUNTY_250K:
            - [0, 0, 0]
      - name: TRAITORGUARDBASE04  # 10x10 destroyed
        width: 10
        length: 10
        groups: [0, 1, 9]
      - name: TRAITORGUARDBASE05  # 20x20 HQ
        width: 20
        length: 20
        groups: 5
        items:
          STR_TRAITOR_GUARD_TURRET_SPAWNER:
            - [8, 18, 0]
            - [18, 11, 0]
        fuseTimers:
          STR_TRAITOR_GUARD_TURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE06  # 20x20 HQ
        width: 20
        length: 20
        groups: 5
        items:
          STR_TRAITOR_GUARD_TURRET_SPAWNER:
            - [6, 18, 0]
            - [18, 6, 0]
        fuseTimers:
          STR_TRAITOR_GUARD_TURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE07  # 20x20 destroyed
        width: 20
        length: 20
        groups: 9
      - name: TRAITORGUARDBASE08  # 20x20 HQ
        width: 20
        length: 20
        groups: 5
        items:
          STR_TRAITOR_GUARD_TURRET_SPAWNER:
            - [14, 16, 0]
            - [15, 5, 0]
        fuseTimers:
