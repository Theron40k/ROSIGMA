            - [3, 15, 0]
            - [15, 15, 0]
            - [15, 3, 0]
            - [3, 3, 0]
        fuseTimers:
          STR_TRAITOR_CHIMERA_TURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE25  # Barracks
