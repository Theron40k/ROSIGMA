        length: 10
      - name: MUNDAINDUSTRIALURBANCULT04  # 2-level, wood fence
        width: 10
        length: 10
      - name: MUNDAINDUSTRIALURBANCULT05  # 2nd story only
        width: 10
        length: 10
      - name: MUNDAINDUSTRIALURBANCULT06  # 2-level
        width: 10
        length: 10
      - name: MUNDAINDUSTRIALURBANCULT07  # bubble-roof
        width: 10
        length: 10
