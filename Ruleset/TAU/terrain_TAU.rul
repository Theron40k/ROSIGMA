      - name: TRAITORGUARDBASE09  # 20x20 BUNKER
        width: 20
        length: 20
        groups: 9
      - name: TRAITORGUARDBASE10  # 10x10 BUNKER
        width: 10
        length: 10
      - name: TRAITORGUARDBASE11  # 10x10 BUNKER
        width: 10
        length: 10
      - name: TRAITORGUARDBASE12  # 10x10 destroyed
