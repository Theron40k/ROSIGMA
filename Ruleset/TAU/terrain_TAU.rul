        width: 10
        length: 10
      - name: TRAITORGUARDBASE18  # HANGAR
        width: 20
        length: 20
      - name: TRAITORGUARDBASE19  # 30x30
        width: 30
        length: 30
        items:
          STR_CHAOSTURRET_SPAWNER:
            - [28, 27, 0]
            - [28, 0, 0]
            - [0, 27, 0]
        fuseTimers:
          STR_CHAOSTURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE20BOMB
        width: 10
        length: 10
      - name: TRAITORGUARDBASE21
        width: 10
        length: 10
      - name: TRAITORGUARDBASE22  # Defense Array
        width: 10
        length: 10
        items:
          STR_TRAITOR_CHIMERA_TURRET_SPAWNER:
            - [1, 7, 1]
            - [1, 1, 1]
            - [7, 1, 1]
            - [7, 7, 1]
          STR_CHAOSTURRET_SPAWNER:
            - [4, 4, 4]
        fuseTimers:
          STR_TRAITOR_CHIMERA_TURRET_SPAWNER: [0, 0]
          STR_CHAOSTURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE23  # Bunker
        width: 10
        length: 10
        items:
          STR_CHAOSTURRET_SPAWNER:
            - [4, 4, 3]
        fuseTimers:
          STR_CHAOSTURRET_SPAWNER: [0, 0]
      - name: TRAITORGUARDBASE24  # Com/Sat Centre
        width: 20
        length: 20
        items:
