### Starter bases handled with adhocScripts fired by initial strategy research event
  - &STR_DESERTER_HIDEOUTS_GV
    type: deserterHideoutGV
    firstMonth: 0
    lastMonth: 10
    missionWeights:
      # 0 is just for safety
      0:
        STR_DESERTER_HIDEOUT_TAU_GV: 100
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    useTable: false
    executionOdds: 30
    startDelay: 150
    randomDelay: 40170 # 4 weeks - 150 minutes
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_HARDER_MISSIONS: false
      STR_TAU_GUEVESA_GV: true

  - type: deserterHideoutHardGV
    refNode: *STR_DESERTER_HIDEOUTS_GV
    missionWeights:
      0:
        STR_DESERTER_HIDEOUT_TAU_HARD_GV: 100
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_HARDER_MISSIONS: true
      STR_TAU_GUEVESA_GV: true

  - type: SpaceHulkGV
    missionWeights:
      # 0 is just for safety
      0:
        STR_ALIEN_ARTIFACT_TAU: 100
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    varName: hulk
    useTable: false
    firstMonth: 6
    executionOdds: 30
    startDelay: 10000
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_TAU_GUEVESA_GV: true

  - type: HULKERTau
    missionWeights:
      0:
        STR_ALIENER_ARTIFACT_TAU: 100
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_TAU_GUEVESA_GV: true
      STR_WARPED_VAULT: true
    firstMonth: 0
    startDelay: 4320  # 3 days
    randomDelay: 4320  # additional random 0 to 3 days
    useTable: false
    maxRuns: 1
    varName: HULKERTau

  - type: MMTau
    missionWeights:
      0:
        STR_CATACOMBS: 20
        STR_RESCUE_PDF_VALKYRIE_TAU: 40  # grounded valkyrie appears on radar, go to support to pick up some PDF, maybe an officer
      2:
        STR_CATACOMBS: 20
        STR_ALIEN_ARTIFACT_TAU: 20  # Space Hulk recurring mission, after initial script
        STR_RESCUE_PDF_VALKYRIE_TAU: 30  # grounded valkyrie appears on radar, go to support to pick up some PDF, maybe an officer
        STR_SUPPORT_PDF_ASSAULT: 30  # PDF assaulting chaos base of cult or traitor guard

      4:
        STR_ALIEN_WAR_TAU: 50  # delays the WAR mission until month 5+
        STR_CATACOMBS: 10
        STR_ALIEN_ARTIFACT_TAU: 10
        STR_RESCUE_PDF_VALKYRIE_TAU: 20
        STR_SUPPORT_PDF_ASSAULT: 20  # PDF assaulting chaos base of cult or traitor guard
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    useTable: false
    firstMonth: 1
    executionOdds: 50
    startDelay: 15000  # 10k = 7 days
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_TAU_GUEVESA_GV: true
      # STR_INQUISITION_ATTENTION: false

