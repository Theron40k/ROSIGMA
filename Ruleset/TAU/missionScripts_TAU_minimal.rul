### Bases #BASE#
  - type: newGVBasesEarly
    missionWeights:
      0:
        STR_TS_CULTIST_BASE_GV: 33
        STR_KTS_TRAITOR_GUARD_BASE_GV: 33
    firstMonth: 1
    lastMonth: 2
    startDelay: 120
    randomDelay: 20160 # Up to 2 weeks random delay
    executionOdds: 70
