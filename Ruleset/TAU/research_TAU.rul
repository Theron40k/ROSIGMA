research:
### core tech tree research -- story event research is in story_research_TAU.rul
  - name: STR_TAU_EMPIRE_GV         # (Tau and friends)
    dependencies:
      - STR_GENERALLOCK
  - name: STR_TAU_GUEVESA_GV         # (Guevesa faction with Imperial weapons access)
    dependencies:
      - STR_GENERALLOCK
  - name: STR_TAU_AUXILIARY_GV         # (Guevesa faction with Imperial weapons access)
    dependencies:
      - STR_GENERALLOCK

  # Everyone has these five by default
  - name: STR_NOT_TAU_EMPIRE_GV         # (Not Tau and friends)
  - name: STR_NOT_TAU_GUEVESA_GV        # (Not xenophile scum)
  - name: STR_NOT_TAU_AUXILIARY_GV      # (Not xenophile scum with friends)
  - name: STR_NOT_DEBUG_TAU_EMPIRE_GV   # (Not cheating Tau and friends)

  - name: STR_REDEEMED_DEFEATED_GV        # (Tau campaign mechanics)
    dependencies:
      - STR_GENERALLOCK
  - name: STR_TENAX_DEFEATED_GV        # (Tau campaign mechanics)
    dependencies:
      - STR_GENERALLOCK
  - name: STR_PRINCEBISHOP_DEFEATED_GV        # (Tau campaign mechanics)
    dependencies:
