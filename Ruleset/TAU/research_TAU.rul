### The Tau condition is
### STR_CHAPTER_PURITY: true
### STR_ARBITES: true
### STR_THE_IMPERIAL_LAW_STRATEGY: false
### STR_NOT_CHAOSCULT: true
### STR_TAU_EMPIRE_GV: true

### PDF commander strategy
### the big strategy that makes all the rules
  - name: STR_TAU_GUEVESA_STRATEGY_GV
    points: 0
    cost: 5
    dependencies:
      - STR_ARBITES
    reenables:
      - STR_CHAPTER_PURITY    # not all who wander are lost
    unlocks:
      - STR_GUARD_BARRACKS
      - STR_SCIENTISTS_AND_ENGINEERS_AVAILABLE
      - STR_PILOT_GUARDSMEN
      - STR_RECRUIT_MILITIA_GV
      - STR_LASER_WEAPONS     # easiest way to activate heavy stubbers (???)
      - STR_IMPERIAL_WEAPONS  # Flamer/Shotgun/Guard Laspistol/Guard Lasgun
      - STR_GUARD_AND_ARBITES # easiest way to activate stub rifles
      - STR_NOT_STEEL_LEGION_STRATEGY # needed to activate normal chimeras (???)
      - STR_TAU_EMPIRE_GV
      - STR_TAU_GUEVESA_GV
      - STR_TAU_AUXILIARY_GV
      - STR_CHAPTER_PURITY
      - STR_NOT_IMPERIUM
      - STR_NOT_CHAOSCULT
      # - STR_NOT_THE_IMPERIAL_LAW
      - STR_ENDGANGERSBASE    # Stop the onslaught of gang events
      - STR_GENESTEALERS_INACTIVE # no genestealers
      - STR_GSC_ARBITES_SPAWNED   # prevent GSC arbites spawn
    disables:
      - STR_GENESTEALERS_ACTIVE
      # - STR_THE_IMPERIAL_LAW_STRATEGY
      - STR_CHAOS_PATH
      - STR_CHAOS_STRATEGY_ARBITES
      - STR_CHAOS_STRATEGY
      - STR_NOT_TAU_EMPIRE_GV
      - STR_NOT_TAU_GUEVESA_GV
      - STR_NOT_TAU_AUXILIARY_GV
      - STR_GREENEST_ORKZ
      - STR_ELDAR_STRATEGY
      - STR_PSI_LAB
      - STR_PSI_AMP
      - STR_COMBAT_SERVITOR_PROGRAM
      - STR_THE_MARTIAN_SOLUTION  # More like a Terran problem!
      - STR_DEFAULT_CAMPAIGN      # alternate Tau versions of this content
      - STR_DIFFICULTY_OPTIONS    # does not have harder missions
    spawnedEvent: STR_TAU_GUEVESA_STRATEGY_EVENT_GV

### Recruit new troops as militia
  - name: STR_RECRUIT_MILITIA_GV
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

### Recruit new troops as guevesa
  - name: STR_RECRUIT_GUEVESA_GV
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

### Progression strategies to mid-tier

### "Remedial Imperial Guard Operations"
### Gives you a 2x2 (1x1?) TRADE facility you can more easily put in a regular base.
### Gives you TRADE access in a convenient package
  - name: STR_WHITESHIELD_BLACK_MARKET_GV
    points: 50
    cost: 150 # was 300, split into Gun Runners
    dependencies:
      - STR_TAU_GUEVESA_GV    # Any Guevesa can hook in here
      - STR_LASER_WEAPONS     # desperate for bigger guns
      - STR_SMOKE
      - STR_MOTION_SCANNER
    needItem: true
    neededItem: STR_KILLPOINT_TOKEN     # kill a bad guy and win a mission
    unlocks:
      - STR_HEAVY_WEAPONS_IG
    spawnedEvent: STR_WHITESHIELD_BLACK_MARKET_EVENT_GV

### Gun Runners unlocks high grade ballistics for you
### Black Market is required
  - name: STR_GUN_RUNNERS_GV
    points: 50
    cost: 150
    dependencies:
      - STR_WHITESHIELD_BLACK_MARKET_GV
      - STR_HEAVY_WEAPONS_IG
    requiresBaseFunc: [TRADE]
    unlocks:
      - STR_BALLISTIC_WEAPONS_HIGHGRADE
    spawnedEvent: STR_GUN_RUNNERS_EVENT_GV

### Discover the Cold Trade
### Discover Tau artifacts
### win a couple missions?
  - name: STR_THE_COLD_TRADE_GV
    points: 50
    cost: 300
    dependencies:
      - STR_WHITESHIELD_BLACK_MARKET_GV
      - STR_ALIEN_ALLOYS
    getOneFree:
      - STR_TAU_TRADING
    spawnedEvent: STR_THE_COLD_TRADE_EVENT_GV   # talk to the Tau here?

### Tau Guevesa trading
  - name: STR_TAU_GUEVESA_TRADING  # Guevesa Trade Agreement
    # gives half price access to Tau Export Pulse Rifles at the Trading Post
    # and Guevesa Flak armor
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_NOT_TAU_GUEVESA_TRADING   # (Not trading at improved terms)
    cost: 0
    points: 0
    dependencies:
      - STR_TAU_TRADING

### Accept Guevesa cultists first - they check you out
### You need to buy an Export Pulse Rifle to get in the system :)
### Cultist periodic arrival events?
  - name: STR_CULTURE_CLUB_GV
    points: 50
    cost: 200
    dependencies:
      - STR_THE_COLD_TRADE_GV
    needItem: true
    neededItem: STR_TAU_PULSE_RIFLE_EXPORT
    spawnedEvent: STR_TAU_PROPAGANDA_EVENT_GV
    # spawnedEvent: STR_CULTURE_CLUB_GV

### Form gue'vesa cluster preliminary to formal Tau pact
### Community outreach to get beastmen soldiers + cultists - can upgrade to Marin'vesa
### gated on mission/interrogation?
  - name: STR_GUEVESA_CLUSTER_GV
    points: 100
    cost: 300
    dependencies:
      - STR_CULTURE_CLUB_GV
      - STR_ELERIUM_115             # guevesa supply crawlers need fuel
      - STR_ALIEN_ALLOYS            # build fortifications and repair things
    unlocks:
      - STR_INQUISITION_ATTENTION_GV      # uh oh!
      - STR_TAU_GUEVESA_TRADING           # unlocks cheaper rifles and carbines + flak
      - STR_RECRUIT_GUEVESA_GV      # turn on guevesa and turn off militia
      - STR_MIDTIER_PREREQ
      - STR_HARDER_MISSIONS
    disables:
      - STR_RECRUIT_MILITIA_GV      # turn on guevesa and turn off militia
      - STR_NOT_TAU_GUEVESA_TRADING       # remove old rifles/charges from market
    spawnedEvent: STR_PATHFINDERS_ARRIVE_FIRST_EVENT_GV  # breadcrumb the navy communications here


#     spawnedEvent: STR_TAU_PROPAGANDA_EVENT_GV
#     spawnedEvent: STR_PATHFINDERS_ARRIVE_FIRST_EVENT_GV # spawns free pathfinders

