manufacture:

  ### Something (prosaic) to do with your purity seals for now
  - name: STR_CONVERT_PURITY_SEALS_GV
    category: STR_ADVANCEMENT
    space: 0
    time: 10
    cost: 1
    requiredItems:
      STR_PURITY_SEAL: 10
    producedItems:
      STR_KILLPOINT_TOKEN: 50

### Recruit guard prisoners as gue'vesa for now
  - &STR_WELCOME_GUEVESALA_GV
    name: STR_WELCOME_GUARD_GV
    category: STR_INDOCTRINATION_CATEGORY_GV
