      - STR_GUEVESA_CLUSTER_GV
    spawnedPersonType: STR_GUEVESALA_GV
    space: 0
    time: 50
    cost: 10000
    requiredItems:
      STR_LIVE_CAPTURE_GUARDAI: 1
    producedItems:
      STR_PURITY_SEAL: 2  # Consider doing something with these later

  - name: STR_WELCOME_CATACHAN_GV
