### pathfinders are pathfinders
  - &STR_TAU_PATHFINDER_TEMPLATE_GV
    type: STR_TAU_PATHFINDER_ARMOR_GV
    requires: STR_TAU_PATHFINDERS_GV
    refNode: *STR_TAU_BASIC_ARMOR_TEMPLATE_GV
    visibilityAtDark: 40
    antiCamouflageAtDark: 10
    antiCamouflageAtDay: 10
    heatVision: 40
    camouflageAtDark: -5 #minor camo
    camouflageAtDay: -3
    spriteSheet: TAUFIREWARRIORPATHFINDERbattlePLAYER_GOG.PCK
    spriteInv: TAUPATHFINDERPLAYER
    customArmorPreviewIndex: 1381
    corpseBattle:
      - STR_TAUFIREWARRIORPATHFINDER_PCCORPSE
    frontArmor: 65 # basic Guard Carapace
    sideArmor: 55
    rearArmor: 35
    underArmor: 55
    forcedTorso: 1
    stats:
      tu: 5  # lighter
      stamina: 5  # lighter
      reactions: 5  # lighter
    tags:
      UNIT_TYPE_LIVING: 1
      UNIT_TYPE_TAU: 1
      UNIT_TYPE_XENO: 1
      HAS_MARKERLIGHT: 1
      ARMOR_OVERWATCH_TU_RESTORED: 10   # all Tau armors get this now
      DODGE_CHANCE: 10
      ARMOR_MAX_SUCCESSFUL_DODGES: 2

  - type: STR_TAU_PATHFINDER_TRANSPECTRAL_ARMOR_GV
    refNode: *STR_TAU_PATHFINDER_TEMPLATE_GV
    requires: STR_FORM_KILL_TEAMS_GV
    storeItem: STR_TAU_PATHFINDER_TRANSPECTRAL_ARMOR_ITEM_GV
    specialWeapon: AUX_ADEPTAS_PROBE
    visibilityAtDay: 40  # Advanced optics and scanners, but not as good as a diviner
    visibilityAtDark: 40  # Optics enhance existing night vision
    antiCamouflageAtDay: 20  # Scanners further enhanced
    antiCamouflageAtDark: 20  # Scanners further enhanced
    psiVision: 10  # Advanced high-power auspex scanner can detect stationary targets and hooks directly into the HUD
    heatVision: 40
    units:
      - STR_FIREWARRIOR_GV
      - STR_FIREWARRIOR_SHASUI_GV
      - STR_FIREWARRIOR_SHASVRE_GV
      - STR_FIREWARRIOR_SHASEL_GV
    builtInWeapons:
      - INV_NULL_AUSPEX

  - type: STR_TAU_PATHFINDER_MEDIC_ARMOR_GV
    refNode: *STR_TAU_PATHFINDER_TEMPLATE_GV
    storeItem: STR_TAU_PATHFINDER_MEDIC_ARMOR_ITEM_GV
    requires: STR_INFILTRATION_CADRE_GV
    specialWeapon: STR_TAU_MEDI_KIT
    units:
      - STR_FIREWARRIOR_GV
      - STR_FIREWARRIOR_SHASUI_GV
      - STR_FIREWARRIOR_SHASVRE_GV
      - STR_FIREWARRIOR_SHASEL_GV
    builtInWeapons:
      - INV_NULL_MEDI_KIT

