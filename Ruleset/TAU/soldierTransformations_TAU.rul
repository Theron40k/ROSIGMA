soldierTransformation:

  - &STR_FIRECASTE_PROMOTION_GV
    name: STR_PROMOTE_SHASUI_GV
    requires:
      - STR_A_SECRET_PACT_GV
    producedSoldierType: STR_FIREWARRIOR_SHASUI_GV
    producedSoldierArmor: STR_TAU_PATHFINDER_LEADER_ARMOR_GV
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    allowedSoldierTypes:
      - STR_FIREWARRIOR_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_PROMOTE_SHASVRE_GV
    refNode: *STR_FIRECASTE_PROMOTION_GV
    requires:
      - STR_A_SECRET_PACT_GV
    producedSoldierType: STR_FIREWARRIOR_SHASVRE_GV
    producedSoldierArmor: STR_TAU_PATHFINDER_LEADER_ARMOR_GV
    allowedSoldierTypes:
      - STR_FIREWARRIOR_SHASUI_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
      STR_VETERAN_COMMENDATION: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_SELECT_FIREBLADE_GV
    refNode: *STR_FIRECASTE_PROMOTION_GV
    requires:
      - STR_APPOINT_FIREBLADE_GV
    producedSoldierType: STR_FIREWARRIOR_FIREBLADE_GV
    producedSoldierArmor: STR_TAUFIREBLADE_ARMOR_GV
    allowedSoldierTypes:
      - STR_FIREWARRIOR_SHASVRE_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
      STR_VETERAN_COMMENDATION: 0
      STR_HERO_TO_THE_IMPERIUM: 0
    requiredMinStats:
      bravery: 50
      tu: 1

### Promote militia officer
  - name: STR_PROMOTE_MILITIA_OFFICER_GV
    requires:
      - STR_TAU_GUEVESA_GV
      - STR_RECRUIT_MILITIA_GV
    producedSoldierType: STR_MILITIA_OFFICER_GV
    producedSoldierArmor: STR_OFFICER_FLAK_ARMOR_NOAIRSTRIKE
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    upperBoundType: 1
    requiredItems:
      STR_OFFICER_COMMISSION: 1
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    lowerBoundAtMinStats: true
    allowedSoldierTypes:
      - STR_MILITIA_GV
    requiredMinStats:
      bravery: 50
      tu: 1

### Transform friendly guard NPCs into militia
  - name: STR_INDUCT_MILITIA_GV
    cost: 0
    requires:
      - STR_TAU_GUEVESA_GV
      - STR_RECRUIT_MILITIA_GV
    producedSoldierType: STR_MILITIA_GV
    producedSoldierArmor: STR_GUARDPD_ARMOR_UC    # get their flak armor back
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_GUARDSM_KRIEG
      - STR_GUARDSM

  - &STR_GUEVESA_PROMOTION_GV
    name: STR_WELCOME_GUEVESALA_GV
    cost: 0
    requires:
      - STR_TAU_GUEVESA_GV
      - STR_RECRUIT_GUEVESA_GV
    producedSoldierType: STR_GUEVESALA_GV
    producedSoldierArmor: STR_TAUGUEVESAFLAK_PC_ARMOR_GV
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_MILITIA_GV
      - STR_GUARDSM_KRIEG
      - STR_GUARDSM
      - STR_PILOT_GUARD
    requiredMinStats:
      tu: 1

  - name: STR_PROMOTE_GUEVESAUI_GV
    refNode: *STR_GUEVESA_PROMOTION_GV
    producedSoldierType: STR_GUEVESAUI_GV
    producedSoldierArmor: STR_TAUGUEVESACARAP_PC_ARMOR_GV
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_MILITIA_GV
      - STR_GUEVESALA_GV
      - STR_MILITIA_OFFICER_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_PROMOTE_GUEVESAVRE_GV
    refNode: *STR_GUEVESA_PROMOTION_GV
    producedSoldierType: STR_GUEVESAVRE_GV
    producedSoldierArmor: STR_TAUGUEVESACARAP_PC_ARMOR_GV
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_GUEVESAUI_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
      STR_VETERAN_COMMENDATION: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_PROMOTE_MARINVESAUI_GV
    refNode: *STR_GUEVESA_PROMOTION_GV
    producedSoldierType: STR_MARINVESAUI_GV
    producedSoldierArmor: STR_TAUMARINVESACARAP_PC_ARMOR_GV
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_MARINVESA_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_PROMOTE_MARINVESAVRE_GV
    refNode: *STR_GUEVESA_PROMOTION_GV
    producedSoldierType: STR_MARINVESAVRE_GV
    producedSoldierArmor: STR_TAUMARINVESACARAP_PC_ARMOR_GV
    upperBoundType: 1
    allowedSoldierTypes:
      - STR_MARINVESAUI_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
    requiredCommendations:
      STR_BATTLE_TESTED: 0
      STR_VETERAN_COMMENDATION: 0
    requiredMinStats:
      bravery: 50
      tu: 1

  - name: STR_TAU_PROMOTE_NOVICE_GV
    cost: 10000
    requires:
      - STR_COOPT_ECCLESIARCHY_GV
    producedSoldierType: STR_ADEPTAS
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    allowedSoldierTypes:
      - STR_ADEPTAS_NOVICE
    minRank: 1
    requiredCommendations:
      STR_BATTLE_TESTED: 0
    requiredMinStats:
      bravery: 40
      firing: 40
      melee: 40

  - name: STR_TAU_PROMOTE_SUPERIOR_GV
    cost: 100000
    requires:
      - STR_COOPT_ECCLESIARCHY_GV
    producedSoldierType: STR_ADEPTAS_SUPERIOR
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    allowedSoldierTypes:
      - STR_ADEPTAS
      - STR_ADEPTAS_PILOT
      - STR_ADEPTAS_VETERAN
      - STR_ADEPTAS_REPENTIA_SUPERIOR  # if you feel like it, no practical difference
      - STR_ADEPTAS_NOVITIATE_SUPERIOR  # if you feel like it, no practical difference
    minRank: 3
    requiredCommendations:
      STR_VETERAN_COMMENDATION: 0
    requiredMinStats:
      bravery: 50
      firing: 50
      melee: 50
      psiSkill: 50

  - name: STR_TAU_PROMOTE_NOVITIATE_SUPERIOR_GV
    cost: 100000
    requires:
      - STR_COOPT_ECCLESIARCHY_GV
    producedSoldierType: STR_ADEPTAS_NOVITIATE_SUPERIOR
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
    allowedSoldierTypes:
      - STR_ADEPTAS
      - STR_ADEPTAS_PILOT
      - STR_ADEPTAS_VETERAN
      - STR_ADEPTAS_SUPERIOR  # if you feel like it, no practical difference
      - STR_ADEPTAS_REPENTIA_SUPERIOR  # if you feel like it, no practical difference
    minRank: 2  # lower rank requirement
    requiredCommendations:
      STR_LONG_SERVICE_TIME: 0  # instead of veteran, pencil pusher
    requiredMinStats:
      bravery: 50
      firing: 40
      melee: 40
      psiSkill: 50

  - name: STR_TAU_PROMOTE_TO_CANONESS_GV
    requires:
      - STR_COOPT_ECCLESIARCHY_GV
    cost: 200000
    requiredItems:
      STR_KILLPOINT_TOKEN: 60
      # STR_ALIEN_HABITAT: 1
    requiredCommendations:
      STR_VETERAN_COMMENDATION: 1
    producedSoldierType: STR_CANONESS
    keepSoldierArmor: true
    allowsDeadSoldiers: false
    allowsWoundedSoldiers: true
    allowsLiveSoldiers: true
    allowedSoldierTypes:
      - STR_ADEPTAS_SUPERIOR
    minRank: 5
    requiredMinStats:
      psiSkill: 60
