  # limited by clip size not by stun
  - &STR_TAU_ARTS_OF_WAR
    type: STR_TAU_LEADER_COMMAND_GV
    requires:
      - STR_TAU_GUEVESA_STRATEGY_GV
    explosionHitSound: {mod: 40k, index: 803}
    hitAnimation: 2050
    specialIconSprite: 10
    recover: false
    accuracyAuto: 200
    accuracyMultiplier:
      flatHundred: 1.0
    arcingShot: false
    damageType: 0
    autoRange: 0
    dropoff: 200
    damageBonus:
      bravery: 0.5
    damageAlter:
      ResistType: 0
      RandomType: 2   # 50-150
      ArmorEffectiveness: 0.0
      ToStun: 0.0
      ToMorale: -0.5
      ToTime: -0.5
      ToEnergy: -1.00
      ToHealth: 0.0
      ToWound: 0.0
      ToTile: 0.0  # this shouldn't blow up cover
      ToItem: 0.0  # this shouldn't damage items
      ToArmor: 0.0  # this shouldn't damage armor
      RadiusReduction: 0.0
      FixRadius: 5
      IgnorePainImmunity: true
      IgnoreNormalMoraleLose: true
    costAuto:  # lowered cost
      time: 60  # was 60 but now % instead of flat
      energy: 60
    hitSound: {mod: 40k, index: 0}
    fireSound: {mod: 40k, index: 491}
    bulletSpeed: -10
    bulletSprite: {mod: 40k, index: 22}
    noLOSAccuracyPenalty: 25  # comms relays
    battleType: 1
    fixedWeapon: true
    clipSize: 1
    experienceTrainingMode: 19


  - type: STR_TAU_VETERAN_COMMAND_GV
    refNode: *STR_TAU_ARTS_OF_WAR
    damageBonus:
      bravery: 0.75
    damageAlter:
      FixRadius: 10
    clipSize: 2


  - type: STR_TAU_FIREBLADE_COMMAND_GV
    refNode: *STR_TAU_ARTS_OF_WAR
    damageBonus:
      bravery: 1.0
    damageAlter:
      FixRadius: 15
    costAuto:  # lowered cost
      time: 40  # was 60 but now % instead of flat
      energy: 40
    clipSize: 3


