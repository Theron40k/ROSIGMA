items:
  - type: STR_TAU_MARKERLIGHT_BEAM
    weight: 0
    armor: 200
    battleType: 1
    damageType: 0
    twoHanded: false
    fixedWeapon: true
    fixedWeaponShow: true
    recover: false
    bigSprite: {mod: 40k, index: 0}
    floorSprite: {mod: 40k, index: 0}
    handSprite: {mod: 40k, index: 8}
    bulletSprite: {mod: 40k, index: 12}
    fireSound: {mod: 40k, index: 741}
    autoRange: 0
    snapRange: 50
    aimRange: 50
    dropoff: 1
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    accuracyAuto: 0
    accuracySnap: 120
    accuracyAimed: 0
    tuAuto: 0
    tuSnap: 30
    tuAimed: 0
    clipSize: -1
    confSnap:
      shots: 1
      ammoSlot: 0
    invWidth: 1
    invHeight: 3
    bulletSpeed: 50


# Used for Stealth suit burst cannons (and manportable ones...)
  - &STR_BURST_CANNONS
    type: STR_TAU_SUIT_BURST_CANNON_GV
    categories: [STR_CAT_PLASMA, STR_CAT_TACTICAL, STR_CAT_TAU]
    weight: 1
    dropoff: 4 #tau carbine
    bigSprite: 3140
    floorSprite: 949
    handSprite: 864
    bulletSprite: {mod: 40k, index: 12}
    fireSound: 2450
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    explosionSpeed: 10
    bulletSpeed: 30
    # carbine accuracy
    accuracyAuto: 60
    accuracySnap: 80
    autoRange: 12
    snapRange: 16
    tuAuto: 40
    tuSnap: 25
    autoShots: 6
    sprayWaypoints: 2
    clipSize: -1
    confSnap:
      name: TAUSUITBC_BURST
      shots: 3
      followProjectiles: false   # the camera stays still while shooting (prevents minigun seizures)
    confAuto:
      name: TAUSUITBC_AUTO
      followProjectiles: false   # the camera stays still while shooting (prevents minigun seizures)
    power: 90
    damageType: 1 # was 5
    damageAlter:  # DA PULSE
      RandomType: 6
      ToArmorPre: 0.1 # was 0.2 # was 0.3  # melts some armor on the way in
      # ArmorEffectiveness: 0.9  # some armor penetration
    battleType: 1
    twoHanded: false
    invWidth: 2
    invHeight: 3
    arcingShot: false
    recover: false
    fixedWeapon: true
    fixedWeaponShow: false
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;

  # Currently used for
  # Starscythe dual burst cannons with S5/AP-1
  # Accelerator Burst Cannon with S6/AP-1 fewer shots
  - type: STR_TAU_SUIT_BURST_CANNON_TWINLINKED_GV
    refNode: *STR_BURST_CANNONS
    damageAlter:  # DA PULSE AP
      RandomType: 6
      ToArmorPre: 0.1 # was 0.2 # was 0.3  # melts some armor on the way in
      ArmorEffectiveness: 0.9  # has armor penetration on tabletop
    shotgunSpread: 1  # twin linked
    shotgunBehavior: 1  # twin linked
    shotgunPellets: 2

# Used for Starscythe single burst cannon on the burst cannon/flamer model
  - type: STR_TAU_STARSCYTHE_BURST_CANNON_SINGLE_GV
    refNode: *STR_BURST_CANNONS
    damageAlter:  # DA PULSE AP
      RandomType: 6
      ToArmorPre: 0.1 # was 0.2 # was 0.3  # melts some armor on the way in
      ArmorEffectiveness: 0.9  # has armor penetration on tabletop

  - type: STR_TAU_SUIT_FLAMER_GV
    categories: [STR_CAT_FLAMER, STR_CAT_TACTICAL]
    size: 0.2
    weight: 1
    bigSprite: {mod: 40k, index: 215}
    floorSprite: {mod: 40k, index: 102}
    handSprite: {mod: 40k, index: 200}
    bulletSprite: {mod: 40k, index: 5}
    fireSound: {mod: 40k, index: 706}
    accuracyAuto: 30
    tuAuto: 35
    battleType: 1
    twoHanded: false
    maxRange: 9
    invWidth: 2
    invHeight: 3
    autoShots: 6
    attraction: 7
    armor: 200
    arcingShot: true
    fixedWeapon: true
    fixedWeaponShow: false
    noLOSAccuracyPenalty: 75  # indirect fire weapon
    power: 60
    powerRangeReduction: 12
    powerRangeThreshold: 12
    damageAlter:
      # IgnoreSelfDestruct: false
      IgnoreDirection: false
      FireBlastCalc: false
      ToHealth: 1.75
      ArmorEffectiveness: 0.7
      ToMorale: 5.0
      ToArmorPre: 0.1
      ToItem: 0.5
      ToTile: 0.5
      IgnoreOverKill: false
      RandomType: 6  # Gaussian
      FixRadius: 3
      ToStun: 0.4
      ToTime: 0.2  # debilitating pain
    clipSize: -1
    bulletSpeed: 30
    explosionSpeed: 10
    # listOrder: 10521
    tags:
      DAMAGE_RESIST_PENETRATION_PERCENT: 25

  - type: STR_TAU_SUIT_FLAMER_TWIN_LINKED_GV
    categories: [STR_CAT_FLAMER, STR_CAT_TACTICAL]
    size: 0.2
    weight: 1
    bigSprite: {mod: 40k, index: 215}
    floorSprite: {mod: 40k, index: 102}
    handSprite: {mod: 40k, index: 200}
    bulletSprite: {mod: 40k, index: 5}
    fireSound: {mod: 40k, index: 706}
    accuracyAuto: 30
    tuAuto: 35
    battleType: 1
    twoHanded: false
    maxRange: 9
    invWidth: 2
    invHeight: 3
    autoShots: 6
    attraction: 7
    armor: 200
    arcingShot: true
    fixedWeapon: true
    fixedWeaponShow: false
    noLOSAccuracyPenalty: 75  # indirect fire weapon
    power: 60
    powerRangeReduction: 12
    powerRangeThreshold: 12
    damageAlter:
      # IgnoreSelfDestruct: false
      IgnoreDirection: false
      FireBlastCalc: false
      IgnoreOverKill: false
      ToHealth: 1.75
      ArmorEffectiveness: 0.7
      ToMorale: 5.0
      ToArmorPre: 0.1
      ToItem: 0.5
      ToTile: 0.5
      RandomType: 6  # Gaussian
      FixRadius: 3
      ToStun: 0.4
      ToTime: 0.2  # debilitating pain
    clipSize: -1
    bulletSpeed: 30
    explosionSpeed: 10
    # listOrder: 10521
    tags:
      DAMAGE_RESIST_PENETRATION_PERCENT: 25
    shotgunSpread: 1  # twin linked
    shotgunBehavior: 1  # twin linked
    shotgunPellets: 2

