### relevant alienDeployments here
alienDeployments:
  - type: STR_INQUISITION_OUTPOST_GV  # Small Inquisition Base
    randomRace: [STR_IMPERIAL_INQUISITION_OUTPOST_LIST_GV]
    markerIcon: 118
    terrains:
      - CITY
    script: INQUISITION_OUTPOST_SCRIPT
    alienBase: true
    customUfo: STR_IMP_LARGE_TRANSPORT  # mixes ship into map
    objectiveComplete: [STR_INQUISITION_OUTPOST_DESTROYED, 200]
    objectiveFailed: [STR_INQUISITION_OUTPOST_NOT_DESTROYED, -100]
    abortPenalty: 100
    data:
      - alienRank: 0  # Inquisitor
        lowQty: 0
        highQty: 0
        dQty: 1
        percentageOutsideUfo: 0
        itemSets: &emptyItemSets
          -
            []
          -
            []
          -
            []
      - alienRank: 1  # Elite Stormtrooper
        lowQty: 1
        highQty: 1
        dQty: 2
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 2  # Stormtrooper
        lowQty: 5
        highQty: 5
        dQty: 1
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 3  # Visiting Dignitaries
        lowQty: 0
        highQty: 0
        dQty: 1
        percentageOutsideUfo: 0
        itemSets: *emptyItemSets
      - alienRank: 4  # Frateris Vet
        lowQty: 2
        highQty: 2  # 3
        dQty: 1  # 1
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 5  # Frateris
        lowQty: 4
        highQty: 4  # 3
        dQty: 6  # 1
        percentageOutsideUfo: 80
        itemSets: *emptyItemSets
      - alienRank: 6 # Assassins
        lowQty: 2
        highQty: 2
        dQty: 1
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 7  # Civillian bystanders, most unarmed
        lowQty: 5
        highQty: 5
        dQty: 2
        percentageOutsideUfo: 90
        itemSets: *emptyItemSets
    briefing:
      cutscene: TERROR
      music: gmstory2
      title: STR_INQUISITION_OUTPOST_ASSAULT_GV
      textOffset: -16
      background: InquisitionBG.SCR
      showTarget: false
      desc: STR_INQUISITION_OUTPOST_ASSAULT_BRIEFING_GV
    markerName: STR_INQUISITION_OUTPOST_GV
    genMission:  # no new base building or retaliations until its upgraded
      STR_INQUISITION_STORMRAVEN_PATROL_SINGLE_GV: 50
      STR_INQUISITION_STORMRAVEN_PATROL_PAIR_GV: 50
      # Need some kind of site based mission
    genMissionFreq: 2
    alienBaseUpgrades:
      0:
        STR_INQUISITION_OUTPOST_GV: 100
      1:
        STR_INQUISITION_OUTPOST_GV: 50
        STR_INQUISITION_BASE_GV: 50
      2:
        STR_INQUISITION_BASE_GV: 100
    width: 50
    length: 50
    height: 12

  - type: STR_INQUISITION_BASE_GV
    randomRace: [STR_IMPERIAL_INQUISITION_BASE_LIST_GV]
    markerIcon: 119
    terrains:
      - CITY
    script: INQUISITION_BASE_SCRIPT
    alienBase: true
    customUfo: STR_IMP_HEAVY_TRANSPORT_SHIP
    objectiveComplete: [STR_INQUISITION_BASE_DESTROYED, 300]
