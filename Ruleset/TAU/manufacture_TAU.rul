manufacture:
  - name: STR_COMMISSAR_REQUISITION
    requires: !add
      - STR_NOT_TAU_EMPIRE_GV

  - name: STR_GUEVESA_LIGHTNING_GV  # green guard variant
    category: STR_CRAFT
    space: 0
    time: 10
    cost: 0
    requires:
      - STR_TAU_GUEVESA_GV
    requiredItems:
      STR_LIGHTNING_TOKEN: 1
    spawnedPersonType: STR_PILOT_GUARD

  - name: STR_ARMORED_TRUCKS_GV
    category: STR_CRAFT
    requires:
      - STR_TAU_GUEVESA_GV
    requiredItems:
      STR_ARMORED_TRUCKS_GV_TOKEN: 1
    space: 0
    time: 10
    cost: 0

  - &STR_SUIT_MANUF_GV
    name: STR_STEALTH_SUIT_ITEM_GV
    category: STR_PERSONAL_ARMOR
    requires:
      - STR_FORM_KILL_TEAMS_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 160
      STR_ALIEN_ALLOYS: 50
      STR_ELERIUM_115: 50
      STR_UFO_CONSTRUCTION: 5
      STR_UFO_POWER_SOURCE: 1
    space: 2
    time: 1500
    cost: 200000

  - name: STR_CRISIS_SUIT_ITEM_GV
    refNode: *STR_SUIT_MANUF_GV
    category: STR_PERSONAL_ARMOR
    requires:
      - STR_STARSCYTHE_CRISIS_OPERATIONS_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 240
      STR_ALIEN_ALLOYS: 100
      STR_ELERIUM_115: 50
      STR_UFO_CONSTRUCTION: 10
      STR_UFO_POWER_SOURCE: 2
    space: 6
    time: 3000
    cost: 300000

  - name: STR_ENGRAVED_ARMOR_ITEM_GV
    category: STR_PERSONAL_ARMOR
    requires:
      - STR_ENGRAVED_ARMORS_GV
    requiredItems:
      STR_KILLPOINT_TOKEN: 160
      STR_ALIEN_ALLOYS: 20
      STR_UFO_CONSTRUCTION: 4
    space: 6
    time: 2000
    cost: 200000

  - name: STR_ENGRAVED_STEALTH_SUIT_ITEM_GV
    category: STR_PERSONAL_ARMOR
    requires:
      - STR_ENGRAVED_ARMORS_GV
      - STR_ENGRAVED_BATTLESUITS_GV
    requiredItems:
      STR_STEALTH_SUIT_ITEM_GV: 1
      STR_KILLPOINT_TOKEN: 160
      STR_ALIEN_ALLOYS: 50
      STR_ELERIUM_115: 50
      STR_UFO_CONSTRUCTION: 5
      STR_UFO_POWER_SOURCE: 1
    space: 6
    time: 2000
    cost: 200000

  - name: STR_GUARD_POWER_ARMOR
    category: STR_PERSONAL_ARMOR
    requires:
      - STR_GUARD_POWER_ARMOR_RESEARCH
    requiredItems:
      STR_ALIEN_ALLOYS: 40
      STR_ELERIUM_115: 20
      STR_KILLPOINT_TOKEN: 120
    producedItems:
      STR_GUARD_POWER_ARMOR: 1
    space: 0
    time: 1000  # significant manufacturing time
    cost: 500000

  - name: STR_DEVILFISH_GV
    category: STR_CRAFT
    requires:
      - STR_DEVILFISH_TRANSPORTS_GV
    space: 8
    time: 4000
    cost: 400000
    listOrder: 3351
    requiredItems:
      STR_ALIEN_ALLOYS: 120
      STR_ELERIUM_115: 80
      STR_UFO_POWER_SOURCE: 4
      STR_UFO_NAVIGATION: 4
      STR_KILLPOINT_TOKEN: 200

  - name: STR_ORCA_GV
    category: STR_CRAFT
    requires:
      - STR_ORCA_DROPSHIPS_GV
    space: 16
    time: 16000
    cost: 1600000
    listOrder: 3352
    requiredItems:
      STR_ALIEN_ALLOYS: 480
      STR_ELERIUM_115: 320
      STR_UFO_POWER_SOURCE: 8
      STR_UFO_NAVIGATION: 8
      STR_KILLPOINT_TOKEN: 1600

  ###
  - name: STR_CONVERT_COMMISSION_GV
    space: 0
    time: 500
    cost: 100000
    requires:
      - STR_TAU_GUEVESA_STRATEGY_GV
      - STR_WHITESHIELD_BLACK_MARKET_GV
