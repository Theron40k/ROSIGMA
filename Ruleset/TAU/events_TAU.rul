events:
  - name: STR_TAU_GUEVESA_STRATEGY_EVENT_GV
    description: STR_TAU_GUEVESA_STRATEGY_CODEX_DESCRIPTION_GV
    background: GuardOffensiveBG.SCR
    # adhocMissionScriptTags: ["intro_missions", "tenaxBaseL1", "PRINCEBISHOPBaseL1", "redeemedBaseL1"]
    spawnedPersons: 20
    spawnedPersonType: STR_MILITIA_GV
    spawnedCraftType: STR_ARMORED_TRUCKS_GV
    everyMultiItemList:
      STR_FLAMETHROWER: 5
      STR_FLAMETHROWER_CLIP: 15
      STR_SHOTGUN: 10
      STR_SHOTGUN_SHELLS: 20
      STR_STUN_SHELLS: 10
      STR_STUB_RIFLE: 5
      STR_STUB_GUN_AMMO: 15
      STR_LASER_RIFLEG: 5
      STR_LASGUN_CLIP: 15
      STR_LASER_PISTOLG: 5
      STR_LASPISTOL_CLIP: 15
      STR_CHAINSWORD: 5
      STR_GRENADE: 10
      STR_KRAK_GRENADE: 10
      STR_TRAUMA_PACK: 4

  # - name: STR_A_MATERIEL_WORLD_EVENT_GV
