    spawnedPersonType: STR_PILOT_GUARD
    spawnedPersons: 1
    timer: 5700
    everyMultiItemList:
      STR_AVALANCHE_LAUNCHER: 2
      STR_AVALANCHE_MISSILES: 16

  # - name: STR_WHITESHIELD_BLACK_MARKET_EVENT_GV
